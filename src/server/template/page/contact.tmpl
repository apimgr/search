{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{t "contact.title"}}</h1>
    </header>

    {{if .ContactSent}}
    <section class="section-card contact-success" aria-labelledby="contact-success-heading">
        <h2 id="contact-success-heading">{{t "contact.success_title"}}</h2>
        {{if .SecurityMode}}
        <p>{{t "contact.security_success_message"}}</p>
        <p class="security-tracking-id">{{t "contact.security_tracking_id_label"}} <strong>{{.TrackingID}}</strong></p>
        {{else}}
        <p>{{if .Config.Server.Pages.Contact.SuccessMessage}}{{.Config.Server.Pages.Contact.SuccessMessage}}{{else}}{{t "contact.success_default"}}{{end}}</p>
        {{end}}
        <a href="/" class="btn btn-primary">{{t "contact.return_home"}}</a>
    </section>
    {{else if .ReviewMode}}
    <div class="contact-review-backdrop">
        <section class="section-card contact-review-panel" aria-labelledby="contact-review-title">
            <h2 id="contact-review-title">{{t "contact.review_title"}}</h2>
            {{if .ContactError}}<p role="alert">{{.ContactError}}</p>{{end}}
            <p class="contact-review-email">{{.ReviewEmail}}</p>
            <dl><dt>{{t "contact.type_label"}}</dt><dd>{{.ReviewType}}</dd><dt>{{t "contact.subject_label"}}</dt><dd>{{.ReviewSubject}}</dd></dl>
            <form action="/server/contact" method="POST">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <input type="hidden" name="form_token" value="{{.FormToken}}">
                <input type="hidden" name="review_token" value="{{.ReviewToken}}">
                {{range $key, $value := .ReviewFields}}<input type="hidden" name="{{$key}}" value="{{$value}}">{{end}}
                <label class="form-checkbox"><input type="checkbox" name="confirmed" value="true" required> {{t "contact.confirm_email_statement"}}</label>
                <button class="btn btn-primary" type="submit" name="step" value="confirm">{{t "common.confirm"}}</button>
                <button class="btn btn-secondary" type="submit" name="step" value="edit" formnovalidate>{{t "common.edit"}}</button>
            </form>
        </section>
    </div>
    {{else}}
    <div class="page-content">
        <p>{{t "contact.form_scope_notice"}}</p>

        <form action="/server/contact" method="POST" class="section-card contact-form">
            <h2>{{t "contact.title"}}</h2>
            {{/* CSRF Token */}}
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

            <div class="contact-honeypot" aria-hidden="true">
                <label for="website">{{t "contact.honeypot_label"}}</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>
            <input type="hidden" name="form_token" value="{{.FormToken}}">

            {{if .SecurityMode}}
            {{/* Coordinated-disclosure mode: security_id plus hidden auto-filled fields, per AI.md PART 11 */}}
            <input type="hidden" name="security_id" value="{{.SecurityID}}">
            <input type="hidden" name="type" value="security">
            <input type="hidden" name="app_version" value="{{.AppVersion}}">
            <input type="hidden" name="commit_hash" value="{{.CommitHash}}">
            <input type="hidden" name="timestamp" value="{{.Timestamp}}">
            <input type="hidden" name="request_user_agent" value="{{.RequestUserAgent}}">
            {{end}}

            {{if not .SecurityMode}}
            <div class="form-group">
                <label for="type">{{t "contact.type_label"}} <span class="required">*</span></label>
                <select id="type" name="type" required>
                    <option value="abuse" {{if eq (index .ReviewFields "type") "abuse"}}selected{{end}}>{{t "contact.type_abuse"}}</option>
                    <option value="dmca" {{if eq (index .ReviewFields "type") "dmca"}}selected{{end}}>{{t "contact.type_dmca"}}</option>
                    <option value="privacy" {{if eq (index .ReviewFields "type") "privacy"}}selected{{end}}>{{t "contact.type_privacy"}}</option>
                </select>
            </div>
            <div class="form-group">
                <label for="reported_url">{{t "contact.reported_url_label"}}</label>
                <input type="url" id="reported_url" name="reported_url" maxlength="2048" value="{{index .ReviewFields "reported_url"}}">
            </div>
            <div class="form-group">
                <label for="reason">{{t "contact.abuse_reason_label"}}</label>
                <select id="reason" name="reason">
                    <option value="illegal_content" {{if eq (index .ReviewFields "reason") "illegal_content"}}selected{{end}}>{{t "contact.reason_illegal_content"}}</option>
                    <option value="terms_violation" {{if eq (index .ReviewFields "reason") "terms_violation"}}selected{{end}}>{{t "contact.reason_terms_violation"}}</option>
                    <option value="harassment" {{if eq (index .ReviewFields "reason") "harassment"}}selected{{end}}>{{t "contact.reason_harassment"}}</option>
                    <option value="malware_phishing" {{if eq (index .ReviewFields "reason") "malware_phishing"}}selected{{end}}>{{t "contact.reason_malware_phishing"}}</option>
                    <option value="other" {{if eq (index .ReviewFields "reason") "other"}}selected{{end}}>{{t "common.other"}}</option>
                </select>
            </div>
            <div class="form-group">
                <label for="copyrighted_work">{{t "contact.copyrighted_work_label"}}</label>
                <input type="text" id="copyrighted_work" name="copyrighted_work" maxlength="1000" value="{{index .ReviewFields "copyrighted_work"}}">
            </div>
            <div class="form-group form-checkbox">
                <label><input type="checkbox" name="good_faith_statement" value="true" {{if eq (index .ReviewFields "good_faith_statement") "true"}}checked{{end}}> {{t "contact.good_faith_statement"}}</label>
                <label><input type="checkbox" name="accuracy_statement" value="true" {{if eq (index .ReviewFields "accuracy_statement") "true"}}checked{{end}}> {{t "contact.accuracy_statement"}}</label>
            </div>
            <div class="form-group">
                <label for="signature">{{t "contact.electronic_signature_label"}}</label>
                <input type="text" id="signature" name="signature" maxlength="254" value="{{index .ReviewFields "signature"}}">
            </div>
            <div class="form-group">
                <label for="request_kind">{{t "contact.privacy_request_label"}}</label>
                <select id="request_kind" name="request_kind">
                    <option value="access" {{if eq (index .ReviewFields "request_kind") "access"}}selected{{end}}>{{t "contact.request_access"}}</option>
                    <option value="export" {{if eq (index .ReviewFields "request_kind") "export"}}selected{{end}}>{{t "contact.request_export"}}</option>
                    <option value="deletion" {{if eq (index .ReviewFields "request_kind") "deletion"}}selected{{end}}>{{t "contact.request_deletion"}}</option>
                    <option value="correction" {{if eq (index .ReviewFields "request_kind") "correction"}}selected{{end}}>{{t "contact.request_correction"}}</option>
                    <option value="opt_out" {{if eq (index .ReviewFields "request_kind") "opt_out"}}selected{{end}}>{{t "contact.request_opt_out"}}</option>
                    <option value="other" {{if eq (index .ReviewFields "request_kind") "other"}}selected{{end}}>{{t "common.other"}}</option>
                </select>
            </div>
            {{end}}

            <div class="form-group">
                <label for="name">{{t "contact.name_label"}} <span class="required">*</span></label>
                <input type="text" id="name" name="name" required value="{{index .ReviewFields "name"}}" placeholder="{{t "contact.name_placeholder"}}" autocomplete="name">
            </div>

            <div class="form-group">
                <label for="email">{{t "contact.email_label"}} {{if not .SecurityMode}}<span class="required">*</span>{{end}}</label>
                <input type="email" id="email" name="email" {{if not .SecurityMode}}required{{end}} value="{{index .ReviewFields "email"}}" placeholder="{{t "contact.email_placeholder"}}" autocomplete="email">
            </div>

            {{if .SecurityMode}}
            <div class="form-group">
                <label for="researcher_gpg">{{t "contact.security_researcher_gpg_label"}}</label>
                <input type="text" id="researcher_gpg" name="researcher_gpg" value="{{.ResearcherGPG}}" placeholder="{{t "contact.security_researcher_gpg_placeholder"}}">
            </div>

            <div class="form-group">
                <label for="affected_component">{{t "contact.security_affected_component_label"}} <span class="required">*</span></label>
                <input type="text" id="affected_component" name="affected_component" required value="{{.AffectedComponent}}" placeholder="{{t "contact.security_affected_component_placeholder"}}">
            </div>

            <div class="form-group">
                <label for="affected_endpoint">{{t "contact.security_affected_endpoint_label"}}</label>
                <input type="text" id="affected_endpoint" name="affected_endpoint" value="{{.AffectedEndpoint}}" placeholder="{{t "contact.security_affected_endpoint_placeholder"}}">
            </div>

            <div class="form-group">
                <label for="severity">{{t "contact.security_severity_label"}} <span class="required">*</span></label>
                <select id="severity" name="severity" required>
                    <option value="critical" {{if eq .Severity "critical"}}selected{{end}}>{{t "contact.security_severity_critical"}}</option>
                    <option value="high" {{if eq .Severity "high"}}selected{{end}}>{{t "contact.security_severity_high"}}</option>
                    <option value="medium" {{if eq .Severity "medium"}}selected{{end}}>{{t "contact.security_severity_medium"}}</option>
                    <option value="low" {{if eq .Severity "low"}}selected{{end}}>{{t "contact.security_severity_low"}}</option>
                    <option value="informational" {{if eq .Severity "informational"}}selected{{end}}>{{t "contact.security_severity_informational"}}</option>
                </select>
            </div>

            <div class="form-group">
                <label for="summary">{{t "contact.security_summary_label"}} <span class="required">*</span></label>
                <input type="text" id="summary" name="summary" required value="{{.Summary}}" placeholder="{{t "contact.security_summary_placeholder"}}">
            </div>

            <div class="form-group">
                <label for="steps_to_reproduce">{{t "contact.security_steps_label"}} <span class="required">*</span></label>
                <textarea id="steps_to_reproduce" name="steps_to_reproduce" rows="6" required placeholder="{{t "contact.security_steps_placeholder"}}">{{.StepsToReproduce}}</textarea>
            </div>

            <div class="form-group">
                <label for="impact">{{t "contact.security_impact_label"}} <span class="required">*</span></label>
                <textarea id="impact" name="impact" rows="4" required placeholder="{{t "contact.security_impact_placeholder"}}">{{.Impact}}</textarea>
            </div>

            <div class="form-group">
                <label for="suggested_fix">{{t "contact.security_suggested_fix_label"}}</label>
                <textarea id="suggested_fix" name="suggested_fix" rows="4" placeholder="{{t "contact.security_suggested_fix_placeholder"}}">{{.SuggestedFix}}</textarea>
            </div>

            <div class="form-group form-checkbox">
                <label for="cve_requested">
                    <input type="checkbox" id="cve_requested" name="cve_requested" value="yes" {{if .CVERequested}}checked{{end}}>
                    {{t "contact.security_cve_requested_label"}}
                </label>
            </div>

            <div class="form-group">
                <label for="disclosure_days">{{t "contact.security_disclosure_days_label"}}</label>
                <input type="number" id="disclosure_days" name="disclosure_days" min="1" value="{{if .DisclosureDays}}{{.DisclosureDays}}{{else}}90{{end}}">
            </div>

            <div class="form-group">
                <label for="credit_preference">{{t "contact.security_credit_preference_label"}} <span class="required">*</span></label>
                <select id="credit_preference" name="credit_preference" required>
                    <option value="real_name" {{if eq .CreditPreference "real_name"}}selected{{end}}>{{t "contact.security_credit_real_name"}}</option>
                    <option value="handle" {{if eq .CreditPreference "handle"}}selected{{end}}>{{t "contact.security_credit_handle"}}</option>
                    <option value="no" {{if eq .CreditPreference "no"}}selected{{end}}>{{t "contact.security_credit_no"}}</option>
                    <option value="anonymous" {{if eq .CreditPreference "anonymous"}}selected{{end}}>{{t "contact.security_credit_anonymous"}}</option>
                </select>
            </div>

            <div class="form-group">
                <label for="credit_handle">{{t "contact.security_credit_name_label"}} <span data-credit-handle-required hidden>*</span></label>
                <input type="text" id="credit_handle" name="credit_handle" maxlength="100" value="{{.CreditHandle}}">
            </div>

            <div class="form-group form-checkbox">
                <label for="agreed_to_disclosure">
                    <input type="checkbox" id="agreed_to_disclosure" name="agreed_to_disclosure" value="yes" required {{if .AgreedToDisclosure}}checked{{end}}>
                    {{t "contact.security_agreement_label"}} <span class="required">*</span>
                </label>
            </div>
            {{else}}
            <div class="form-group">
                <label for="subject">{{t "contact.subject_label"}} <span class="required">*</span></label>
                <input type="text" id="subject" name="subject" required value="{{index .ReviewFields "subject"}}" placeholder="{{t "contact.subject_placeholder"}}">
            </div>

            <div class="form-group">
                <label for="message">{{t "contact.message_label"}} <span class="required">*</span></label>
                <textarea id="message" name="message" rows="6" required placeholder="{{t "contact.message_placeholder"}}">{{index .ReviewFields "message"}}</textarea>
            </div>
            {{end}}

            {{if .CaptchaRequired}}
            {{if .CaptchaExternal}}
            <div class="form-group captcha-group">
                {{if eq .CaptchaProvider "recaptcha"}}
                <div class="g-recaptcha" data-sitekey="{{.CaptchaSiteKey}}"></div>
                <script src="https://www.google.com/recaptcha/api.js" async defer></script>
                {{else if eq .CaptchaProvider "hcaptcha"}}
                <div class="h-captcha" data-sitekey="{{.CaptchaSiteKey}}"></div>
                <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
                {{end}}
            </div>
            {{else if .CaptchaLocal}}
            <div class="form-group captcha-group">
                <label for="captcha">{{tf "contact.verification_question" "a" .CaptchaA "b" .CaptchaB}} <span class="required">*</span></label>
                <input type="hidden" name="captcha_id" value="{{.CaptchaID}}">
                <input type="number" id="captcha" name="captcha" required placeholder="{{t "contact.answer_placeholder"}}" autocomplete="off">
            </div>
            {{end}}
            {{end}}

            {{if .ContactError}}
            <div class="form-error">
                {{.ContactError}}
            </div>
            {{end}}

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">{{t "contact.send_message"}}</button>
            </div>
        </form>
        <section class="section-card contact-information" aria-labelledby="contact-security-heading">
            <h2 id="contact-security-heading">{{t "contact.security_issues_heading"}}</h2>
            <p>{{t "contact.security_issues_intro"}} <a href="/server/security">{{t "security.policy_title"}}</a>.</p>
        </section>
        <section class="section-card contact-information" aria-labelledby="contact-abuse-heading">
            <h2 id="contact-abuse-heading">{{t "contact.abuse_reports_heading"}}</h2>
            <p>{{t "contact.abuse_reports_intro"}} {{if not .SecurityMode}}<a href="#type">{{t "security.report_abuse_link"}}</a>. {{end}}{{if .Config.Server.Contact.Abuse.Email}}{{tf "contact.abuse_reports_email" "email" .Config.Server.Contact.Abuse.Email}}{{else if .Config.Server.Contact.General.Email}}{{tf "contact.abuse_reports_email" "email" .Config.Server.Contact.General.Email}}{{end}}</p>
        </section>
    </div>
    {{end}}
</div>
{{end}}
