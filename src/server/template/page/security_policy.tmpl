{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t "accessibility.breadcrumb"}}"><a href="/server/security">← {{t "security.overview_title"}}</a></nav>
        <h1 class="page-title">{{t "security.policy_title"}}</h1>
    </header>

        <section class="section-card security-section" aria-labelledby="security-policy-policy-scope-heading">
            <h2 id="security-policy-policy-scope-heading">{{t "security.policy_scope_heading"}}</h2>
            <p>{{tf "security.policy_scope_description" "fqdn" .FQDN}}</p>
        </section>

        <section class="section-card security-section" aria-labelledby="security-policy-policy-disclosure-window-heading">
            <h2 id="security-policy-policy-disclosure-window-heading">{{t "security.policy_disclosure_window_heading"}}</h2>
            <p>{{t "security.policy_disclosure_window_description"}}</p>
        </section>

        <section class="section-card security-section" aria-labelledby="security-policy-policy-in-scope-heading">
            <h2 id="security-policy-policy-in-scope-heading">{{t "security.policy_in_scope_heading"}}</h2>
            <ul>
                <li>{{t "security.policy_in_scope_item_deployed"}}</li>
                <li>{{t "security.policy_in_scope_item_api"}}</li>
                <li>{{t "security.policy_in_scope_item_auth"}}</li>
                <li>{{tf "security.policy_in_scope_item_host" "host" .FQDN}}</li>
                {{range .Domains}}
                <li>{{tf "security.policy_in_scope_item_host" "host" .}}</li>
                {{end}}
                {{if .OnionAddress}}<li>{{tf "security.policy_in_scope_item_tor" "address" .OnionAddress}}</li>{{end}}
                {{if .I2PAddress}}<li>{{tf "security.policy_in_scope_item_i2p" "address" .I2PAddress}}</li>{{end}}
            </ul>
        </section>

        <section class="section-card security-section" aria-labelledby="security-policy-policy-out-of-scope-heading">
            <h2 id="security-policy-policy-out-of-scope-heading">{{t "security.policy_out_of_scope_heading"}}</h2>
            <ul>
                <li>{{t "security.policy_out_of_scope_item_dos"}}</li>
                <li>{{t "security.policy_out_of_scope_item_social"}}</li>
                <li>{{t "security.policy_out_of_scope_item_physical"}}</li>
                <li>{{t "security.policy_out_of_scope_item_third_party"}}</li>
                <li>{{t "security.policy_out_of_scope_item_scanner"}}</li>
                <li>{{t "security.policy_out_of_scope_item_headers"}}</li>
            </ul>
        </section>

        <section class="section-card security-section" aria-labelledby="security-policy-policy-safe-harbor-heading">
            <h2 id="security-policy-policy-safe-harbor-heading">{{t "security.policy_safe_harbor_heading"}}</h2>
            <p>{{t "security.policy_safe_harbor_description"}}</p>
        </section>

        <section class="section-card" aria-labelledby="security-policy-reporting-heading">
            <h2 id="security-policy-reporting-heading">{{t "security.policy_reporting_heading"}}</h2>
            <p>{{t "security.policy_reporting_description"}} <a href="/server/security">{{t "security.overview_title"}}</a></p>
        </section>
</div>
{{end}}
