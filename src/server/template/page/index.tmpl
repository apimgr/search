{{define "content"}}
<div class="home-container">
    <div class="logo-section">
        {{if .Config.Server.Branding.Logo}}
        <img src="{{.Config.Server.Branding.Logo}}" alt="{{.Config.Server.Title}}" class="home-logo-img">
        {{else}}
        <h1 class="home-logo"><svg class="home-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 6 6"></path></svg>{{if .Config.Server.Branding.Title}}{{.Config.Server.Branding.Title}}{{else}}{{t "home.brand_fallback"}}{{end}}</h1>
        {{end}}
        <p class="home-tagline">{{.Config.Server.Description}}</p>
    </div>

    <form action="/search" method="GET" class="search-form" id="searchForm">
        <noscript>
            <label for="nojs-category">{{t "search.category"}}</label>
            <select id="nojs-category" name="category">
                <option value="general">{{t "preferences.default_category_general"}}</option>
                <option value="images">{{t "search.categories.images"}}</option>
                <option value="videos">{{t "search.categories.videos"}}</option>
                <option value="news">{{t "search.categories.news"}}</option>
                <option value="maps">{{t "search.categories.maps"}}</option>
                <option value="files">{{t "search.categories.files"}}</option>
                <option value="music">{{t "preferences.default_category_music"}}</option>
                <option value="science">{{t "search.categories.science"}}</option>
                <option value="it">{{t "search.categories.it"}}</option>
                <option value="social">{{t "search.categories.social"}}</option>
            </select>
        </noscript>
        <input type="hidden" name="category" id="categoryInput" value="{{default "general" .Category}}">
        {{if .PrefsQuery}}<input type="hidden" name="prefs" value="{{.PrefsQuery}}">{{end}}
        <div class="search-box">
            <input type="text" name="q" id="searchQuery" placeholder="{{t "home.search_placeholder"}}" aria-label="{{t "common.search"}}" autofocus required autocomplete="off" class="search-input">
            <button type="button" class="advanced-search-trigger" aria-label="{{t "search.advanced"}}" id="advancedSearchBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="8" r="2"></circle>
                    <path d="M11 10v5"></path>
                    <circle cx="11" cy="19" r="2"></circle>
                    <path d="M11 21v-4"></path>
                    <circle cx="5" cy="14" r="2"></circle>
                    <path d="M5 16v3M5 12V5"></path>
                    <circle cx="17" cy="12" r="2"></circle>
                    <path d="M17 14v5M17 10V5"></path>
                </svg>
            </button>
            <button type="submit" class="search-btn" aria-label="{{t "search.button"}}">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </button>
        </div>

        <div class="category-tabs" role="tablist">
            <button type="button" class="category-tab{{if eq .Category "general"}} active{{end}}" data-category="general" role="tab" aria-selected="{{if eq .Category "general"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path></svg>
                <span class="tab-text">{{t "preferences.default_category_general"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "images"}} active{{end}}" data-category="images" role="tab" aria-selected="{{if eq .Category "images"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
                <span class="tab-text">{{t "search.categories.images"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "videos"}} active{{end}}" data-category="videos" role="tab" aria-selected="{{if eq .Category "videos"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="13" height="14" rx="2"></rect><path d="m16 10 5-3v10l-5-3z"></path></svg>
                <span class="tab-text">{{t "search.categories.videos"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "news"}} active{{end}}" data-category="news" role="tab" aria-selected="{{if eq .Category "news"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="1"></rect><path d="M7 8h4v4H7zM14 8h4M14 12h4M7 16h11"></path></svg>
                <span class="tab-text">{{t "search.categories.news"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "maps"}} active{{end}}" data-category="maps" role="tab" aria-selected="{{if eq .Category "maps"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15"></path></svg>
                <span class="tab-text">{{t "search.categories.maps"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "files"}} active{{end}}" data-category="files" role="tab" aria-selected="{{if eq .Category "files"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h7l2 2h9v11H3z"></path></svg>
                <span class="tab-text">{{t "search.categories.files"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "music"}} active{{end}}" data-category="music" role="tab" aria-selected="{{if eq .Category "music"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                <span class="tab-text">{{t "preferences.default_category_music"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "science"}} active{{end}}" data-category="science" role="tab" aria-selected="{{if eq .Category "science"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 3h6M10 3v7l-5 8a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-8V3M8 15h8"></path></svg>
                <span class="tab-text">{{t "search.categories.science"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "it"}} active{{end}}" data-category="it" role="tab" aria-selected="{{if eq .Category "it"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="16" height="13" rx="1"></rect><path d="M2 21h20M9 17l-1 4m7-4 1 4"></path></svg>
                <span class="tab-text">{{t "search.categories.it"}}</span>
            </button>
            <button type="button" class="category-tab{{if eq .Category "social"}} active{{end}}" data-category="social" role="tab" aria-selected="{{if eq .Category "social"}}true{{else}}false{{end}}">
                <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3h.5a8.5 8.5 0 0 1 8 8z"></path></svg>
                <span class="tab-text">{{t "search.categories.social"}}</span>
            </button>
        </div>
    </form>

    <noscript>
        <form action="/search" method="GET" class="advanced-search-fallback">
            <h2>{{t "search.advanced"}}</h2>
            <input type="hidden" name="category" value="general">
            {{if .PrefsQuery}}<input type="hidden" name="prefs" value="{{.PrefsQuery}}">{{end}}
            <label for="nojs-as-allwords">{{t "search.advanced_modal.all_words"}}</label>
            <input id="nojs-as-allwords" type="text" name="as_allwords" placeholder="{{t "search.advanced_modal.all_words_placeholder"}}">
            <label for="nojs-as-exactphrase">{{t "search.advanced_modal.exact_phrase"}}</label>
            <input id="nojs-as-exactphrase" type="text" name="as_exactphrase" placeholder="{{t "search.advanced_modal.exact_phrase_placeholder"}}">
            <label for="nojs-as-anywords">{{t "search.advanced_modal.any_words"}}</label>
            <input id="nojs-as-anywords" type="text" name="as_anywords" placeholder="{{t "search.advanced_modal.any_words_placeholder"}}">
            <label for="nojs-as-nonewords">{{t "search.advanced_modal.exclude_words"}}</label>
            <input id="nojs-as-nonewords" type="text" name="as_nonewords" placeholder="{{t "search.advanced_modal.exclude_words_placeholder"}}">
            <label for="nojs-as-site">{{t "search.advanced_modal.site"}}</label>
            <input id="nojs-as-site" type="text" name="as_site" placeholder="site:example.com">
            <label for="nojs-as-filetype">{{t "search.advanced_modal.file_type"}}</label>
            <select id="nojs-as-filetype" name="as_filetype">
                <option value="">{{t "home.file_type_any"}}</option>
                <option value="pdf">PDF</option>
                <option value="doc">{{t "home.file_type_word"}}</option>
                <option value="docx">{{t "search.advanced_modal.word_docx"}}</option>
                <option value="xls">{{t "home.file_type_excel"}}</option>
                <option value="xlsx">{{t "search.advanced_modal.excel_xlsx"}}</option>
                <option value="ppt">{{t "search.advanced_modal.powerpoint"}}</option>
                <option value="txt">{{t "home.file_type_text"}}</option>
            </select>
            <label for="nojs-as-time">{{t "search.time_range"}}</label>
            <select id="nojs-as-time" name="as_time">
                <option value="">{{t "search.any_time"}}</option>
                <option value="day">{{t "search.past_day"}}</option>
                <option value="week">{{t "search.past_week"}}</option>
                <option value="month">{{t "search.past_month"}}</option>
                <option value="year">{{t "search.past_year"}}</option>
            </select>
            <label for="nojs-as-lang">{{t "search.language"}}</label>
            <select id="nojs-as-lang" name="as_lang">
                <option value="">{{t "home.any_language"}}</option>
                <option value="en">{{t "home.language_english"}}</option>
                <option value="es">{{t "home.language_spanish"}}</option>
                <option value="fr">{{t "home.language_french"}}</option>
                <option value="de">{{t "home.language_german"}}</option>
                <option value="zh">{{t "home.language_chinese"}}</option>
                <option value="ja">{{t "home.language_japanese"}}</option>
            </select>
            <label for="nojs-as-region">{{t "search.region"}}</label>
            <select id="nojs-as-region" name="as_region">
                <option value="">{{t "search.advanced_modal.any_region"}}</option>
                <option value="us">{{t "search.advanced_modal.region_us"}}</option>
                <option value="uk">{{t "search.advanced_modal.region_uk"}}</option>
                <option value="de">{{t "search.advanced_modal.region_de"}}</option>
                <option value="fr">{{t "search.advanced_modal.region_fr"}}</option>
                <option value="es">{{t "search.advanced_modal.region_es"}}</option>
                <option value="it">{{t "search.advanced_modal.region_it"}}</option>
                <option value="jp">{{t "search.advanced_modal.region_jp"}}</option>
                <option value="cn">{{t "search.advanced_modal.region_cn"}}</option>
                <option value="br">{{t "search.advanced_modal.region_br"}}</option>
                <option value="au">{{t "search.advanced_modal.region_au"}}</option>
                <option value="ca">{{t "search.advanced_modal.region_ca"}}</option>
                <option value="in">{{t "search.advanced_modal.region_in"}}</option>
            </select>
            <button type="submit" class="btn btn-primary">{{t "search.button"}}</button>
        </form>
    </noscript>

    <section class="search-history" id="search-history" hidden aria-labelledby="search-history-title">
        <div class="search-history-heading">
            <h2 id="search-history-title">{{t "preferences.recent_searches"}}</h2>
            <button type="button" class="btn btn-secondary" id="clear-search-history">{{t "preferences.clear_history"}}</button>
        </div>
        <ul class="search-history-list" id="search-history-list"></ul>
    </section>

    {{/* Widget Grid Section */}}
    {{template "widgets" .}}

    <div class="home-features">
        <div class="feature">
            <span class="feature-icon">🔒</span>
            <span class="feature-text">{{t "home.feature_no_tracking"}}</span>
        </div>
        <div class="feature">
            <span class="feature-icon">🌐</span>
            <span class="feature-text">{{t "home.feature_multiple_engines"}}</span>
        </div>
        <div class="feature">
            <span class="feature-icon">🧅</span>
            <span class="feature-text">{{t "home.feature_tor_support"}}</span>
        </div>
    </div>
</div>

{{/* Advanced Search Modal - per AI.md PART 16: Server-side rendering with progressive enhancement */}}
<dialog id="advancedSearchModal" class="advanced-search-modal">
    <header>
        <h2>{{t "search.advanced"}}</h2>
        <button type="button" class="close-btn" id="advancedSearchClose" aria-label="{{t "common.close"}}">&times;</button>
    </header>
    <form action="/search" method="GET" class="advanced-search-content">
        <input type="hidden" name="category" value="general">
        {{if .PrefsQuery}}<input type="hidden" name="prefs" value="{{.PrefsQuery}}">{{end}}

        <div class="advanced-search-group">
            <label for="as-allwords">{{t "search.advanced_modal.all_words"}}</label>
            <input type="text" id="as-allwords" name="as_allwords" placeholder="{{t "search.advanced_modal.all_words_placeholder"}}">
        </div>

        <div class="advanced-search-group">
            <label for="as-exactphrase">{{t "search.advanced_modal.exact_phrase"}}</label>
            <input type="text" id="as-exactphrase" name="as_exactphrase" placeholder="{{t "search.advanced_modal.exact_phrase_placeholder"}}">
        </div>

        <div class="advanced-search-group">
            <label for="as-anywords">{{t "search.advanced_modal.any_words"}}</label>
            <input type="text" id="as-anywords" name="as_anywords" placeholder="{{t "search.advanced_modal.any_words_placeholder"}}">
        </div>

        <div class="advanced-search-group">
            <label for="as-nonewords">{{t "search.advanced_modal.exclude_words"}}</label>
            <input type="text" id="as-nonewords" name="as_nonewords" placeholder="{{t "search.advanced_modal.exclude_words_placeholder"}}">
        </div>

        <div class="advanced-search-row">
            <div class="advanced-search-group half">
                <label for="as-site">{{t "search.advanced_modal.site"}}</label>
                <input type="text" id="as-site" name="as_site" placeholder="site:example.com">
            </div>
            <div class="advanced-search-group half">
                <label for="as-filetype">{{t "search.advanced_modal.file_type"}}</label>
                <select id="as-filetype" name="as_filetype">
                    <option value="">{{t "home.file_type_any"}}</option>
                    <option value="pdf">PDF</option>
                    <option value="doc">{{t "home.file_type_word"}}</option>
                    <option value="xls">{{t "home.file_type_excel"}}</option>
                    <option value="ppt">PowerPoint</option>
                    <option value="txt">{{t "home.file_type_text"}}</option>
                </select>
            </div>
        </div>

        <div class="advanced-search-row">
            <div class="advanced-search-group half">
                <label for="as-time">{{t "search.time_range"}}</label>
                <select id="as-time" name="as_time">
                    <option value="">{{t "search.any_time"}}</option>
                    <option value="day">{{t "search.past_day"}}</option>
                    <option value="week">{{t "search.past_week"}}</option>
                    <option value="month">{{t "search.past_month"}}</option>
                    <option value="year">{{t "search.past_year"}}</option>
                </select>
            </div>
            <div class="advanced-search-group half">
                <label for="as-lang">{{t "search.language"}}</label>
                <select id="as-lang" name="as_lang">
                    <option value="">{{t "home.any_language"}}</option>
                    <option value="en">{{t "home.language_english"}}</option>
                    <option value="es">{{t "home.language_spanish"}}</option>
                    <option value="fr">{{t "home.language_french"}}</option>
                    <option value="de">{{t "home.language_german"}}</option>
                    <option value="zh">{{t "home.language_chinese"}}</option>
                    <option value="ja">{{t "home.language_japanese"}}</option>
                </select>
            </div>
        </div>

        <div class="advanced-search-group">
            <label for="as-region">{{t "search.region"}}</label>
            <select id="as-region" name="as_region">
                <option value="">{{t "search.advanced_modal.any_region"}}</option>
                <option value="us">{{t "search.advanced_modal.region_us"}}</option>
                <option value="uk">{{t "search.advanced_modal.region_uk"}}</option>
                <option value="de">{{t "search.advanced_modal.region_de"}}</option>
                <option value="fr">{{t "search.advanced_modal.region_fr"}}</option>
                <option value="es">{{t "search.advanced_modal.region_es"}}</option>
                <option value="it">{{t "search.advanced_modal.region_it"}}</option>
                <option value="jp">{{t "search.advanced_modal.region_jp"}}</option>
                <option value="cn">{{t "search.advanced_modal.region_cn"}}</option>
                <option value="br">{{t "search.advanced_modal.region_br"}}</option>
                <option value="au">{{t "search.advanced_modal.region_au"}}</option>
                <option value="ca">{{t "search.advanced_modal.region_ca"}}</option>
                <option value="in">{{t "search.advanced_modal.region_in"}}</option>
            </select>
        </div>

        <div class="advanced-search-preview">
            <label>{{t "search.advanced_modal.query_preview"}}</label>
            <code id="as-preview">{{t "home.query_preview_empty"}}</code>
        </div>
    </form>
    <footer>
        <button type="button" class="btn btn-secondary" id="advancedSearchCancel">{{t "common.cancel"}}</button>
        <button type="button" class="btn btn-primary" id="advancedSearchSubmit">{{t "search.button"}}</button>
    </footer>
</dialog>
{{end}}
{{/* Per AI.md PART 16: NO inline JS - all scripts in app.js */}}
