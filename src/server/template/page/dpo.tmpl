{{define "content"}}
<div class="container container-sm">
  <header class="page-header">
    <h1 class="page-title">{{t "dpo.title"}}</h1>
  </header>
  <section class="section-card" aria-labelledby="dpo-contact-heading">
  <h2 id="dpo-contact-heading">{{t "contact.page_title"}}</h2>
  {{if .DPOName}}<p>{{.DPOName}}</p>{{end}}
  {{if .DPOEmail}}
  <p><a href="mailto:{{.DPOEmail}}">{{.DPOEmail}}</a></p>
  {{else}}
  <p><a href="/server/security">{{t "security.overview_title"}}</a></p>
  {{end}}
  <p><a href="/server/privacy">{{t "footer.privacy_policy"}}</a></p>
  </section>
</div>
{{end}}
