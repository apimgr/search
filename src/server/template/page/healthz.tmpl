{{define "content"}}
{{/* Per AI.md PART 13: Health Check HTML Response */}}
<div class="container container-lg">
    {{/* Project Header - per AI.md PART 13 */}}
    <header class="page-header health-header">
        {{if .Health.Project.Name}}
        <h1 class="page-title">📦 {{.Health.Project.Name}}</h1>
        {{if .Health.Project.Tagline}}
        <p class="tagline">{{.Health.Project.Tagline}}</p>
        {{end}}
        <p class="page-lead description">{{.Health.Project.Description}}</p>
        {{else}}
        <h1 class="page-title">📦 {{.Config.Server.Title}}</h1>
        <p class="page-lead description">{{.Config.Server.Description}}</p>
        {{end}}
    </header>

    {{/* Status Banner - per AI.md PART 13 */}}
    <div class="status-banner {{if eq .Health.Status "healthy"}}status-ok{{else if or (eq .Health.Status "degraded") (eq .Health.Status "restart_required")}}status-warning{{else}}status-error{{end}}">
        {{if eq .Health.Status "healthy"}}
        <span class="status-icon">✅</span>
        <span class="status-text">{{t "health.banner_healthy"}}</span>
        {{else if eq .Health.Status "degraded"}}
        <span class="status-icon">⚠️</span>
        <span class="status-text">{{t "health.banner_degraded"}}</span>
        {{else}}
        <span class="status-icon">❌</span>
        <span class="status-text">{{t (printf "health.%s" .Health.Status)}}</span>
        {{end}}
    </div>

        {{/* Version & Build per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-version-heading">
            <h2 id="health-version-heading">ℹ️ {{t "health.section.version"}}</h2>
            <dl class="info-list">
                    <dt>{{t "health.version"}}</dt>
                    <dd><code>{{if eq (version) "dev"}}{{t "health.dev_build"}}{{else}}{{version}}{{end}}</code></dd>
                    <dt>{{t "health.go_version"}}</dt>
                    <dd><code>{{if .Health.GoVersion}}{{.Health.GoVersion}}{{else}}{{t "health.unknown"}}{{end}}</code></dd>
                    <dt>{{t "health.commit"}}</dt>
                    <dd><code>{{if .Health.Build.Commit}}{{.Health.Build.Commit}}{{else}}{{t "health.dev_build"}}{{end}}</code></dd>
                    <dt>{{t "health.build_date"}}</dt>
                    <dd>{{if .Health.Build.Date}}{{healthTimestamp .Health.Build.Date}}{{else}}{{t "health.local_build"}}{{end}}</dd>
            </dl>
        </section>

        {{/* Runtime per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-runtime-heading">
            <h2 id="health-runtime-heading">⏱️ {{t "health.section.runtime"}}</h2>
            <dl class="info-list">
                    <dt>{{t "health.uptime"}}</dt>
                    <dd>{{healthDuration .Health.Uptime}}</dd>
                    <dt>{{t "health.mode"}}</dt>
                    <dd>
                        {{if eq .Health.Mode "production"}}
                        <span class="badge badge-production">{{t "health.mode_production"}}</span>
                        {{else if eq .Health.Mode "development"}}
                        <span class="badge badge-development">{{t "health.mode_development"}}</span>
                        {{else}}
                        <span class="badge badge-debug">{{t "health.mode_debug"}}</span>
                        {{end}}
                    </dd>
                    <dt>{{t "health.last_check"}}</dt>
                    <dd><time datetime="{{.Health.Timestamp}}">{{healthTimestamp .Health.Timestamp}}</time></dd>
            </dl>
        </section>

        {{/* Features per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-features-heading">
            <h2 id="health-features-heading">🎛️ {{t "health.section.features"}}</h2>
            <ul class="feature-list">
                <li class="{{if .Health.Features.Tor.Enabled}}feature-enabled{{else}}feature-disabled{{end}}">
                    <span>🧅 {{t "health.tor_hidden_service"}}</span>
                    {{if eq .Health.Features.Tor.Status "healthy"}}
                    <span class="status status-ok">{{t "health.active"}}</span>
                    {{else if eq .Health.Features.Tor.Status "unavailable"}}
                    <span class="status status-warning">{{t "health.unavailable"}}</span>
                    {{else if eq .Health.Features.Tor.Status "disabled"}}
                    <span class="status">{{t "common.disabled"}}</span>
                    {{else}}
                    <span class="status status-warning">{{t "health.starting"}}</span>
                    {{end}}
                    <span>{{t "health.lifecycle_state"}}: {{if eq .Health.Features.Tor.State "disabled"}}{{t "common.disabled"}}{{else if eq .Health.Features.Tor.State "no_provider"}}{{t "health.no_provider"}}{{else if eq .Health.Features.Tor.State "starting"}}{{t "health.starting"}}{{else if eq .Health.Features.Tor.State "building"}}{{t "health.starting"}}{{else if eq .Health.Features.Tor.State "running"}}{{t "health.active"}}{{else}}{{t "health.unavailable"}}{{end}}</span>
                    {{if .Health.Features.Tor.Hostname}}
                    <div class="code-block">
                        <code class="code-content onion-address">{{.Health.Features.Tor.Hostname}}</code>
                        <button type="button" class="copy-btn" data-copy="{{.Health.Features.Tor.Hostname}}" aria-label="{{t "accessibility.copy_to_clipboard"}}">
                            <span class="copy-icon">📋</span>
                            <span class="copy-text">{{t "common.copy"}}</span>
                        </button>
                    </div>
                    {{end}}
                </li>

                <li class="{{if .Health.Features.I2P.Enabled}}feature-enabled{{else}}feature-disabled{{end}}">
                    <span>🌐 I2P</span>
                    {{if eq .Health.Features.I2P.Status "healthy"}}
                    <span class="status status-ok">{{t "health.active"}}</span>
                    {{else if eq .Health.Features.I2P.Status "unavailable"}}
                    <span class="status status-warning">{{t "health.unavailable"}}</span>
                    {{else if eq .Health.Features.I2P.Status "disabled"}}
                    <span class="status">{{t "common.disabled"}}</span>
                    {{else}}
                    <span class="status status-warning">{{t "health.starting"}}</span>
                    {{end}}
                    <span>{{t "health.lifecycle_state"}}: {{if eq .Health.Features.I2P.State "disabled"}}{{t "common.disabled"}}{{else if eq .Health.Features.I2P.State "no_provider"}}{{t "health.no_provider"}}{{else if eq .Health.Features.I2P.State "starting"}}{{t "health.starting"}}{{else if eq .Health.Features.I2P.State "building"}}{{t "health.starting"}}{{else if eq .Health.Features.I2P.State "running"}}{{t "health.active"}}{{else}}{{t "health.unavailable"}}{{end}}</span>
                    {{if .Health.Features.I2P.Hostname}}
                    <div class="code-block">
                        <code class="code-content">{{.Health.Features.I2P.Hostname}}</code>
                        <button type="button" class="copy-btn" data-copy="{{.Health.Features.I2P.Hostname}}" aria-label="{{t "accessibility.copy_to_clipboard"}}">
                            <span class="copy-icon">📋</span>
                            <span class="copy-text">{{t "common.copy"}}</span>
                        </button>
                    </div>
                    {{end}}
                </li>
                {{if .Health.Features.GeoIP}}
                <li class="feature-enabled">
                    <span>🌍 {{t "health.geoip"}}</span>
                    <span class="status status-ok">{{t "common.enabled"}}</span>
                </li>
                {{else}}
                <li class="feature-disabled">
                    <span>🌍 {{t "health.geoip"}}</span>
                    <span class="status">{{t "common.disabled"}}</span>
                </li>
                {{end}}
            </ul>
        </section>



        {{/* Component Status per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-checks-heading">
            <h2 id="health-checks-heading">🔧 {{t "health.section.checks"}}</h2>
            <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th scope="col">{{t "health.component_status_heading"}}</th><th scope="col">{{t "health.status"}}</th></tr></thead>
                <tbody>
                <tr><td>{{t "health.components.database"}}</td><td><span class="badge status {{if eq .Health.Checks.Database "ok"}}status-ok{{else if eq .Health.Checks.Database "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Health.Checks.Database "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Database "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td>
                </tr>
                <tr><td>{{t "health.components.cache"}}</td><td><span class="badge status {{if eq .Health.Checks.Cache "ok"}}status-ok{{else if eq .Health.Checks.Cache "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Health.Checks.Cache "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Cache "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td></tr>
                <tr><td>{{t "health.components.disk_space"}}</td><td><span class="badge status {{if eq .Health.Checks.Disk "ok"}}status-ok{{else if eq .Health.Checks.Disk "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Health.Checks.Disk "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Disk "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td></tr>
                <tr><td>{{t "health.components.scheduler"}}</td><td><span class="badge status {{if eq .Health.Checks.Scheduler "ok"}}status-ok{{else if eq .Health.Checks.Scheduler "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Health.Checks.Scheduler "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Scheduler "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td></tr>
                {{if .Health.Checks.Tor}}
                <tr><td>{{t "health.components.tor"}}</td><td><span class="badge status {{if eq .Health.Checks.Tor "ok"}}status-ok{{else if eq .Health.Checks.Tor "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Health.Checks.Tor "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Tor "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td></tr>
                {{end}}
                {{if .Health.Checks.I2P}}
                <tr><td>{{t "health.components.i2p"}}</td><td><span class="badge status {{if eq .Health.Checks.I2P "ok"}}status-ok{{else if eq .Health.Checks.I2P "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Health.Checks.I2P "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.I2P "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td></tr>
                {{end}}
                {{range .Health.Checks.Extra}}
                <tr><td>{{healthLabel "check" .Key}}</td><td><span class="badge status {{if eq .Status "ok"}}status-ok{{else if eq .Status "degraded"}}status-warning{{else}}status-error{{end}}">{{if eq .Status "ok"}}{{t "health.component_operational"}}{{else if eq .Status "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span></td></tr>
                {{end}}
                </tbody>
            </table>
            </div>
        </section>

        {{/* Statistics per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-stats-heading">
            <h2 id="health-stats-heading">📈 {{t "health.section.stats"}}</h2>
            <dl class="info-list">
                    <dt>{{t "health.total_requests"}}</dt>
                    <dd>{{healthCount .Health.Stats.RequestsTotal}}</dd>
                    <dt>{{t "health.requests_24h"}}</dt>
                    <dd>{{healthCount .Health.Stats.Requests24h}}</dd>
                    <dt>{{t "health.active_connections"}}</dt>
                    <dd>{{healthCount .Health.Stats.ActiveConns}}</dd>
                {{range .Health.Stats.Extra}}
                    <dt>{{healthLabel "stat" .Key}}</dt>
                    <dd>{{healthCount .Value}}</dd>
                {{end}}
            </dl>
        </section>

    {{/* Footer */}}
    <footer class="health-footer">
        <p>{{t "health.last_updated"}} <time datetime="{{.Health.Timestamp}}">{{healthTimestamp .Health.Timestamp}}</time></p>
        <p class="auto-refresh">
            {{t "health.auto_refresh_in"}} <span id="countdown">30</span>s
        </p>
    </footer>
</div>
{{/* Per AI.md PART 16: NO inline JS - auto-refresh in app.js */}}
{{end}}
