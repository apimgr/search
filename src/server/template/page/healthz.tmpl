{{define "content"}}
{{/* Per AI.md PART 13: Health Check HTML Response */}}
<div class="container container-lg">
    {{/* Project Header - per AI.md PART 13 */}}
    <header class="page-header health-header">
        {{if .Health.Project.Name}}
        <h1 class="page-title">📦 {{.Health.Project.Name}}</h1>
        {{if .Health.Project.Tagline}}
        <p class="tagline">{{.Health.Project.Tagline}}</p>
        {{end}}
        <p class="page-lead description">{{.Health.Project.Description}}</p>
        {{else}}
        <h1 class="page-title">📦 {{.Config.Server.Title}}</h1>
        <p class="page-lead description">{{.Config.Server.Description}}</p>
        {{end}}
    </header>

    {{/* Status Banner - per AI.md PART 13 */}}
    <div class="status-banner {{if eq .Health.Status "healthy"}}status-ok{{else if or (eq .Health.Status "degraded") (eq .Health.Status "restart_required")}}status-warning{{else}}status-error{{end}}">
        {{if eq .Health.Status "healthy"}}
        <span class="status-icon">✅</span>
        <span class="status-text">{{t "health.banner_healthy"}}</span>
        {{else if eq .Health.Status "degraded"}}
        <span class="status-icon">⚠️</span>
        <span class="status-text">{{t "health.banner_degraded"}}</span>
        {{else}}
        <span class="status-icon">❌</span>
        <span class="status-text">{{t (printf "health.%s" .Health.Status)}}</span>
        {{end}}
    </div>

    <div class="health-grid">
        {{/* Version & Build per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-version-heading">
            <h2 id="health-version-heading">ℹ️ {{t "health.section.version"}}</h2>
            <dl class="health-info">
                <div class="info-row">
                    <dt>{{t "health.version"}}</dt>
                    <dd><code>{{if eq (version) "dev"}}{{t "health.dev_build"}}{{else}}{{version}}{{end}}</code></dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.go_version"}}</dt>
                    <dd><code>{{if .Health.GoVersion}}{{.Health.GoVersion}}{{else}}{{t "health.unknown"}}{{end}}</code></dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.commit"}}</dt>
                    <dd><code>{{if .Health.Build.Commit}}{{.Health.Build.Commit}}{{else}}{{t "health.dev_build"}}{{end}}</code></dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.build_date"}}</dt>
                    <dd>{{if .Health.Build.Date}}{{healthTimestamp .Health.Build.Date}}{{else}}{{t "health.local_build"}}{{end}}</dd>
                </div>
            </dl>
        </section>

        {{/* Runtime per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-runtime-heading">
            <h2 id="health-runtime-heading">⏱️ {{t "health.section.runtime"}}</h2>
            <dl class="health-info">
                <div class="info-row">
                    <dt>{{t "health.uptime"}}</dt>
                    <dd>{{healthDuration .Health.Uptime}}</dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.mode"}}</dt>
                    <dd>
                        {{if eq .Health.Mode "production"}}
                        <span class="badge badge-production">{{t "health.mode_production"}}</span>
                        {{else if eq .Health.Mode "development"}}
                        <span class="badge badge-development">{{t "health.mode_development"}}</span>
                        {{else}}
                        <span class="badge badge-debug">{{t "health.mode_debug"}}</span>
                        {{end}}
                    </dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.last_check"}}</dt>
                    <dd><time datetime="{{.Health.Timestamp}}">{{healthTimestamp .Health.Timestamp}}</time></dd>
                </div>
            </dl>
        </section>

        {{/* Features per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-features-heading">
            <h2 id="health-features-heading">🎛️ {{t "health.section.features"}}</h2>
            <ul class="feature-list">
                <li class="feature-item {{if .Health.Features.Tor.Enabled}}feature-enabled{{else}}feature-disabled{{end}}">
                    <span class="feature-icon">🧅</span>
                    <span class="feature-name">{{t "health.tor_hidden_service"}}</span>
                    {{if eq .Health.Features.Tor.Status "healthy"}}
                    <span class="feature-status status-ok">{{t "health.active"}}</span>
                    {{else if eq .Health.Features.Tor.Status "unavailable"}}
                    <span class="feature-status status-warning">{{t "health.unavailable"}}</span>
                    {{else if eq .Health.Features.Tor.Status "disabled"}}
                    <span class="feature-status">{{t "common.disabled"}}</span>
                    {{else}}
                    <span class="feature-status status-warning">{{t "health.starting"}}</span>
                    {{end}}
                    <span class="feature-state">{{t "health.lifecycle_state"}}: {{if eq .Health.Features.Tor.State "disabled"}}{{t "common.disabled"}}{{else if eq .Health.Features.Tor.State "no_provider"}}{{t "health.no_provider"}}{{else if eq .Health.Features.Tor.State "starting"}}{{t "health.starting"}}{{else if eq .Health.Features.Tor.State "building"}}{{t "health.starting"}}{{else if eq .Health.Features.Tor.State "running"}}{{t "health.active"}}{{else}}{{t "health.unavailable"}}{{end}}</span>
                </li>
                {{if .Health.Features.Tor.Hostname}}
                <li class="feature-detail">
                    <div class="code-block">
                        <code class="code-content onion-address">{{.Health.Features.Tor.Hostname}}</code>
                        <button type="button" class="copy-btn" data-copy="{{.Health.Features.Tor.Hostname}}" aria-label="{{t "accessibility.copy_to_clipboard"}}">
                            <span class="copy-icon">📋</span>
                            <span class="copy-text">{{t "common.copy"}}</span>
                        </button>
                    </div>
                </li>
                {{end}}

                <li class="feature-item {{if .Health.Features.I2P.Enabled}}feature-enabled{{else}}feature-disabled{{end}}">
                    <span class="feature-name">I2P</span>
                    {{if eq .Health.Features.I2P.Status "healthy"}}
                    <span class="feature-status status-ok">{{t "health.active"}}</span>
                    {{else if eq .Health.Features.I2P.Status "unavailable"}}
                    <span class="feature-status status-warning">{{t "health.unavailable"}}</span>
                    {{else if eq .Health.Features.I2P.Status "disabled"}}
                    <span class="feature-status">{{t "common.disabled"}}</span>
                    {{else}}
                    <span class="feature-status status-warning">{{t "health.starting"}}</span>
                    {{end}}
                    <span class="feature-state">{{t "health.lifecycle_state"}}: {{if eq .Health.Features.I2P.State "disabled"}}{{t "common.disabled"}}{{else if eq .Health.Features.I2P.State "no_provider"}}{{t "health.no_provider"}}{{else if eq .Health.Features.I2P.State "starting"}}{{t "health.starting"}}{{else if eq .Health.Features.I2P.State "building"}}{{t "health.starting"}}{{else if eq .Health.Features.I2P.State "running"}}{{t "health.active"}}{{else}}{{t "health.unavailable"}}{{end}}</span>
                </li>
                {{if .Health.Features.I2P.Hostname}}
                <li class="feature-detail">
                    <code class="code-content">{{.Health.Features.I2P.Hostname}}</code>
                </li>
                {{end}}
                {{if .Health.Features.GeoIP}}
                <li class="feature-item feature-enabled">
                    <span class="feature-icon">🌍</span>
                    <span class="feature-name">{{t "health.geoip"}}</span>
                    <span class="feature-status status-ok">{{t "common.enabled"}}</span>
                </li>
                {{else}}
                <li class="feature-item">
                    <span class="feature-name">{{t "health.geoip"}}</span>
                    <span class="feature-status">{{t "common.disabled"}}</span>
                </li>
                {{end}}
            </ul>
        </section>



        {{/* Component Status per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-checks-heading">
            <h2 id="health-checks-heading">🔧 {{t "health.section.checks"}}</h2>
            <ul class="component-list">
                <li class="component-item {{if eq .Health.Checks.Database "ok"}}component-ok{{else if eq .Health.Checks.Database "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Health.Checks.Database "ok"}}✓{{else if eq .Health.Checks.Database "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">{{t "health.components.database"}}</span>
                    <span class="component-status">{{if eq .Health.Checks.Database "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Database "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                <li class="component-item {{if eq .Health.Checks.Cache "ok"}}component-ok{{else if eq .Health.Checks.Cache "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Health.Checks.Cache "ok"}}✓{{else if eq .Health.Checks.Cache "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">{{t "health.components.cache"}}</span>
                    <span class="component-status">{{if eq .Health.Checks.Cache "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Cache "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                <li class="component-item {{if eq .Health.Checks.Disk "ok"}}component-ok{{else if eq .Health.Checks.Disk "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Health.Checks.Disk "ok"}}✓{{else if eq .Health.Checks.Disk "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">{{t "health.components.disk_space"}}</span>
                    <span class="component-status">{{if eq .Health.Checks.Disk "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Disk "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                <li class="component-item {{if eq .Health.Checks.Scheduler "ok"}}component-ok{{else if eq .Health.Checks.Scheduler "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Health.Checks.Scheduler "ok"}}✓{{else if eq .Health.Checks.Scheduler "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">{{t "health.components.scheduler"}}</span>
                    <span class="component-status">{{if eq .Health.Checks.Scheduler "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Scheduler "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                {{if .Health.Checks.Tor}}
                <li class="component-item {{if eq .Health.Checks.Tor "ok"}}component-ok{{else if eq .Health.Checks.Tor "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Health.Checks.Tor "ok"}}✓{{else if eq .Health.Checks.Tor "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">{{t "health.components.tor"}}</span>
                    <span class="component-status">{{if eq .Health.Checks.Tor "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.Tor "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                {{end}}
                {{if .Health.Checks.I2P}}
                <li class="component-item {{if eq .Health.Checks.I2P "ok"}}component-ok{{else if eq .Health.Checks.I2P "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Health.Checks.I2P "ok"}}✓{{else if eq .Health.Checks.I2P "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">I2P</span>
                    <span class="component-status">{{if eq .Health.Checks.I2P "ok"}}{{t "health.component_operational"}}{{else if eq .Health.Checks.I2P "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                {{end}}
                {{range .Health.Checks.Extra}}
                <li class="component-item {{if eq .Status "ok"}}component-ok{{else if eq .Status "degraded"}}component-warning{{else}}component-error{{end}}">
                    <span class="component-icon">{{if eq .Status "ok"}}✓{{else if eq .Status "degraded"}}!{{else}}✕{{end}}</span>
                    <span class="component-name">{{healthLabel "check" .Key}}</span>
                    <span class="component-status">{{if eq .Status "ok"}}{{t "health.component_operational"}}{{else if eq .Status "degraded"}}{{t "health.degraded"}}{{else}}{{t "health.component_error"}}{{end}}</span>
                </li>
                {{end}}
            </ul>
        </section>

        {{/* Statistics per AI.md PART 13 */}}
        <section class="section-card" aria-labelledby="health-stats-heading">
            <h2 id="health-stats-heading">📈 {{t "health.section.stats"}}</h2>
            <dl class="health-info stats-info">
                <div class="info-row">
                    <dt>{{t "health.total_requests"}}</dt>
                    <dd>{{healthCount .Health.Stats.RequestsTotal}}</dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.requests_24h"}}</dt>
                    <dd>{{healthCount .Health.Stats.Requests24h}}</dd>
                </div>
                <div class="info-row">
                    <dt>{{t "health.active_connections"}}</dt>
                    <dd>{{healthCount .Health.Stats.ActiveConns}}</dd>
                </div>
                {{range .Health.Stats.Extra}}
                <div class="info-row">
                    <dt>{{healthLabel "stat" .Key}}</dt>
                    <dd>{{healthCount .Value}}</dd>
                </div>
                {{end}}
            </dl>
        </section>
    </div>

    {{/* Footer */}}
    <footer class="health-footer">
        <p>{{t "health.last_updated"}} <time datetime="{{.Health.Timestamp}}">{{healthTimestamp .Health.Timestamp}}</time></p>
        <p class="auto-refresh">
            <span class="refresh-indicator"></span>
            {{t "health.auto_refresh_in"}} <span id="countdown">30</span>s
        </p>
    </footer>
</div>
{{/* Per AI.md PART 16: NO inline JS - auto-refresh in app.js */}}
{{end}}
