{{define "content"}}
<div class="container container-md">
    <article class="privacy-policy">
    <header class="page-header">
        <h1 class="page-title">{{t "footer.privacy_policy"}}</h1>
    </header>
    <p class="last-updated">{{t "health.last_updated"}} <time datetime="{{.BuildDate}}">{{.BuildDate}}</time></p>

        {{/* Summary key points — the sold/not-sold point swaps on server.privacy.data.sold */}}
        <section class="section-card privacy-section privacy-summary" id="summary" aria-labelledby="privacy-summary-heading">
            <h2 id="privacy-summary-heading">{{t "privacy.summary_heading"}}</h2>
            <div class="key-points">
                <div class="key-point">
                    <span class="icon" aria-hidden="true">🔒</span>
                    <strong>{{t "privacy.summary_stored_title"}}</strong>
                    <p>{{t "privacy.summary_stored_desc"}}</p>
                </div>
                {{if .DataSold}}
                <div class="key-point key-point-warning">
                    <span class="icon" aria-hidden="true">⚠️</span>
                    <strong>{{t "privacy.summary_sold_title"}}</strong>
                    <p>{{t "privacy.summary_sold_desc"}} <a href="#ccpa-opt-out">{{t "privacy.summary_sold_optout"}}</a></p>
                </div>
                {{else}}
                <div class="key-point">
                    <span class="icon" aria-hidden="true">🚫</span>
                    <strong>{{t "privacy.summary_not_sold_title"}}</strong>
                    <p>{{t "privacy.summary_not_sold_desc"}}</p>
                </div>
                {{end}}
                <div class="key-point">
                    <span class="icon" aria-hidden="true">🎛️</span>
                    <strong>{{t "privacy.summary_control_title"}}</strong>
                    <p>{{t "privacy.summary_control_desc"}}</p>
                </div>
            </div>
        </section>

        {{/* Cookie categories from server.privacy.cookies; analytics description swaps on data.sold */}}
        <section class="section-card privacy-section" id="cookies" aria-labelledby="privacy-cookies-heading">
            <h2 id="privacy-cookies-heading">{{t "privacy.cookies_heading"}}</h2>
            <p>{{t "privacy.cookies_intro"}}</p>
            <ul>
                {{if .Config.Server.Privacy.Cookies.Essential.Enabled}}
                <li><strong>{{t "privacy.session_cookie_label"}}:</strong> {{.Config.Server.Privacy.Cookies.Essential.Description}}</li>
                {{end}}
                {{if .Config.Server.Privacy.Cookies.Preferences.Enabled}}
                <li><strong>{{t "privacy.preference_cookie_label"}}:</strong> {{.Config.Server.Privacy.Cookies.Preferences.Description}}</li>
                {{end}}
            </ul>
            {{if .Config.Server.Privacy.Cookies.Analytics.Enabled}}
            <h3>{{t "privacy.analytics_heading"}}</h3>
            {{if and .Config.Server.Tracking.Type (ne .Config.Server.Tracking.Type "none")}}
            <p>{{if .DataSold}}{{t "privacy.analytics_suffix_sold"}}{{else}}{{t "privacy.analytics_suffix_not_sold"}}{{end}}</p>
            <p>{{.Config.Server.Privacy.AnalyticsDescription}}</p>
            <p>{{tf "privacy.analytics_provider" "provider" (title .Config.Server.Tracking.Type)}}</p>
            {{else}}
            <p>{{t "privacy.analytics_none"}}</p>
            {{end}}
            {{end}}
            <p>{{t "privacy.cookies_followup"}}</p>
            <p>{{if .CookieConsent}}<button type="button" class="btn-secondary" data-action="cookie-preferences">{{default "Manage Preferences" .CookieConsent.PreferencesText}}</button> {{end}}<a href="/server/preferences#privacy">{{t "preferences.title"}}</a></p>
        </section>

        <section class="section-card privacy-section" aria-labelledby="privacy-data-collection-heading">
            <h2 id="privacy-data-collection-heading">{{t "privacy.data_collection_heading"}}</h2>
            {{ .Config.Server.Privacy.Content.DataCollection | markdownToHTML }}
        </section>

        {{/* Data usage copy swaps on server.privacy.data.sold (data_usage vs data_usage_if_sold) */}}
        <section class="section-card privacy-section" aria-labelledby="privacy-data-usage-heading">
            <h2 id="privacy-data-usage-heading">{{t "privacy.data_usage_heading"}}</h2>
            {{if .DataSold}}
            {{.Config.Server.Privacy.Content.DataUsageIfSold | markdownToHTML}}
            {{else}}
            {{.Config.Server.Privacy.Content.DataUsage | markdownToHTML}}
            {{end}}
        </section>

        <section class="section-card privacy-section" aria-labelledby="privacy-data-security-heading">
            <h2 id="privacy-data-security-heading">{{t "privacy.data_security_heading"}}</h2>
            {{ .Config.Server.Privacy.Content.DataSecurity | markdownToHTML }}
            <p>{{if .RequestSecure}}{{t "privacy.connection_tls"}}{{else}}{{t "privacy.connection_no_tls"}}{{end}}</p>
        </section>

        {{/* Data storage note swaps on server.privacy.data.sold */}}
        <section class="section-card privacy-section" id="data-storage" aria-labelledby="privacy-data-storage-heading">
            <h2 id="privacy-data-storage-heading">{{t "privacy.data_storage_heading"}}</h2>
            {{if .Config.Server.Privacy.Data.StoredOnServer}}
            <p>{{t "privacy.data_stored_on_server"}}</p>
            {{else}}
            <p>{{t "privacy.data_stored_off_server"}}</p>
            {{end}}
            {{if .Config.Server.Privacy.Data.Sharing}}
            <h3>{{t "privacy.data_sharing_heading"}}</h3>
            <ul>
                {{range .Config.Server.Privacy.Data.Sharing}}
                <li><strong>{{title (replace .Condition "_" " ")}}:</strong> {{.When}} — {{.Data}}</li>
                {{end}}
            </ul>
            {{else}}
            <p>{{t "privacy.data_sharing_none"}}</p>
            {{end}}
            <p>{{if .DataSold}}{{t "privacy.data_storage_may_sell"}}{{else}}{{t "privacy.data_storage_never_sold"}}{{end}}</p>
        </section>

        {{/* Retention period from server.privacy.retention.period (falls back to translated default) */}}
        <section class="section-card privacy-section" aria-labelledby="privacy-data-retention-heading">
            <h2 id="privacy-data-retention-heading">{{t "privacy.data_retention_heading"}}</h2>
            <p>{{privacyRetentionPeriod .Config.Server.Privacy.Retention}}</p>
        </section>

        {{/* Third-party services from server.privacy.third_party.services */}}
        <section class="section-card privacy-section" aria-labelledby="privacy-third-parties-heading">
            <h2 id="privacy-third-parties-heading">{{t "privacy.third_parties_heading"}}</h2>
            {{if .Config.Server.Privacy.ThirdParty.Services}}
            <p>{{t "privacy.third_parties_intro"}}</p>
            <div class="table-wrapper"><table class="data-table third-party-table">
                <thead>
                    <tr>
                        <th scope="col">{{t "privacy.third_parties_col_service"}}</th>
                        <th scope="col">{{t "privacy.third_parties_col_purpose"}}</th>
                        <th scope="col">{{t "privacy.third_parties_col_data"}}</th>
                        <th scope="col">{{t "privacy.third_parties_col_policy"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Config.Server.Privacy.ThirdParty.Services}}
                    <tr>
                        <td>{{.Name}}</td>
                        <td>{{.Purpose}}</td>
                        <td>{{.DataSent}}</td>
                        <td>{{if .PolicyURL}}<a href="{{.PolicyURL}}" target="_blank" rel="noopener">{{t "privacy.third_parties_view_policy"}}</a>{{end}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table></div>
            {{else}}
            <p>{{t "privacy.third_parties_description"}}</p>
            <p>{{t "privacy.third_parties_followup"}}</p>
            {{end}}
        </section>

        {{/* Your rights — export/deletion items gated by server.privacy.retention flags */}}
        <section class="section-card privacy-section" aria-labelledby="privacy-your-rights-heading">
            <h2 id="privacy-your-rights-heading">{{t "privacy.your_rights_heading"}}</h2>
            {{if or .Config.Server.Privacy.Retention.ExportAvailable .Config.Server.Privacy.Retention.DeletionAvailable}}
            <p>{{t "privacy.your_rights_intro"}}</p>
            <ul>
                <li><strong>{{t "privacy.your_rights_access_label"}}:</strong> {{t "privacy.your_rights_access_desc"}}</li>
                {{if .Config.Server.Privacy.Retention.ExportAvailable}}
                <li><strong>{{t "privacy.your_rights_export_label"}}:</strong> {{t "privacy.your_rights_export_desc"}}</li>
                {{end}}
                {{if .Config.Server.Privacy.Retention.DeletionAvailable}}
                <li><strong>{{t "privacy.your_rights_deletion_label"}}:</strong> {{t "privacy.your_rights_deletion_desc"}}</li>
                {{end}}
                <li><strong>{{t "privacy.your_rights_correction_label"}}:</strong> {{t "privacy.your_rights_correction_desc"}}</li>
            </ul>
            {{else}}
            <p>{{t "privacy.your_rights_description"}}</p>
            {{end}}
        </section>

        {{if operatorHTMLExists "privacy" .}}
        <section class="section-card markdown" aria-labelledby="privacy-additional-heading">
            <h2 id="privacy-additional-heading">{{t "privacy.additional_information_heading"}}</h2>
            {{operatorHTML "privacy" .}}
        </section>
        {{end}}
        <section class="section-card" aria-labelledby="privacy-page-title-heading">
            <h2 id="privacy-page-title-heading">{{t "contact.page_title"}}</h2>
            <p>{{t "privacy.contact_prefix"}} {{if .Config.Server.Contact.DPO.Email}}<a href="mailto:{{.Config.Server.Contact.DPO.Email}}">{{.Config.Server.Contact.DPO.Email}}</a>{{else}}<a href="/server/security">{{t "contact.title"}}</a>{{end}}{{t "privacy.contact_suffix"}}</p>
        </section>
    {{if .DataSold}}
    <section class="section-card privacy-section ccpa-section" id="ccpa-opt-out" aria-labelledby="privacy-ccpa-heading">
        <h2 id="privacy-ccpa-heading">{{t "privacy.ccpa_opt_out_heading"}}</h2>
        <p>{{t "privacy.ccpa_opt_out_description"}}</p>
        {{if .CCPAOptedOut}}
        <p class="ccpa-status">{{t "privacy.ccpa_opt_out_status_active"}}</p>
        <form method="post" action="/server/ccpa">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="action" value="opt-in">
            <input type="hidden" name="optout" value="false">
            <button type="submit" class="btn">{{t "privacy.ccpa_opt_in_button"}}</button>
        </form>
        {{else}}
        <form method="post" action="/server/ccpa">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="action" value="opt-out">
            <input type="hidden" name="optout" value="true">
            <button type="submit" class="btn btn-decline">{{t "privacy.ccpa_opt_out_button"}}</button>
        </form>
        {{end}}
    </section>
    {{end}}
    </article>
</div>
{{end}}
