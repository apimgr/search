{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t "accessibility.breadcrumb"}}"><a href="/server/preferences">← {{t "preferences.title"}}</a></nav>
        <h1 class="page-title">{{t "preferences.tools_page_title"}}</h1>
        <p class="page-lead">{{t "preferences.tools_page_description"}}</p>
    </header>
    <section class="section-card preferences-section" data-preference-tab="interface" aria-labelledby="search-bangs-heading">
        <h2 id="search-bangs-heading">{{t "preferences.search_bangs_heading"}}</h2>
        <p class="help-text">
            {{t "preferences.search_bangs_help_prefix"}} <code>!g</code> {{t "preferences.search_bangs_help_google"}},
            <code>!w</code> {{t "preferences.search_bangs_help_wikipedia"}}, <code>!yt</code> {{t "preferences.search_bangs_help_youtube"}}.
        </p>

        <div class="bang-categories">
            <h3>{{t "preferences.available_bangs"}}</h3>
            <div class="category-filter">
                <button type="button" class="btn btn-secondary filter-btn active" data-category="all">{{t "common.all"}}</button>
                {{range .Data.categories}}
                <button type="button" class="btn btn-secondary filter-btn" data-category="{{.}}">{{. | title}}</button>
                {{end}}
            </div>

            <div class="hub-list bang-list" id="bang-list">
                {{range .Data.bangs}}
                <div class="hub-item bang-item" data-category="{{.Category}}">
                    <span class="bang-shortcut">!{{.Shortcut}}</span>
                    <span class="bang-name">{{.Name}}</span>
                    {{if .Description}}
                    <span class="bang-description">{{.Description}}</span>
                    {{end}}
                </div>
                {{end}}
            </div>
        </div>
    </section>

    <section class="section-card preferences-section" data-preference-tab="interface" aria-labelledby="custom-bangs-heading">
        <h2 id="custom-bangs-heading">{{t "preferences.custom_bangs_heading"}}</h2>
        <p class="help-text">{{t "preferences.custom_bangs_help"}}</p>

        <div id="custom-bangs-list" class="custom-bangs-list">
            <div id="custom-bangs-empty-state" class="empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="7" cy="7" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="7" cy="17" r="1"/></svg>
                <h3 class="empty-state-title">{{t "preferences.custom_bangs_empty"}}</h3>
                <p class="empty-state-message">{{t "preferences.custom_bangs_help"}}</p>
                <a class="btn btn-primary" href="#add-custom-bang">{{t "preferences.add_custom_bang"}}</a>
            </div>
            <div id="custom-bangs-items"></div>
        </div>

        <form id="add-custom-bang" class="add-bang-form">
            <h3>{{t "preferences.add_custom_bang"}}</h3>
            <div class="form-row">
                <div class="form-group">
                    <label for="bang-shortcut">{{t "preferences.shortcut_label"}}</label>
                    <input class="form-input" type="text" id="bang-shortcut" name="shortcut" placeholder="{{t "preferences.shortcut_placeholder"}}" required pattern="[a-zA-Z0-9_-]+">
                </div>
                <div class="form-group">
                    <label for="bang-name">{{t "preferences.name_label"}}</label>
                    <input class="form-input" type="text" id="bang-name" name="name" placeholder="{{t "preferences.name_placeholder"}}" required>
                </div>
            </div>
            <div class="form-group">
                <label for="bang-url">{{t "preferences.url_template_label"}}</label>
                <input class="form-input" type="text" id="bang-url" name="url" inputmode="url" autocomplete="url" placeholder="{{t "preferences.url_template_placeholder"}}" required>
                <small class="form-help">{{t "preferences.url_template_help_prefix"}} <code>{query}</code> {{t "preferences.url_template_help_suffix"}}</small>
            </div>
            <div class="form-group">
                <label for="bang-category">{{t "search.category"}}</label>
                <input class="form-input" type="text" id="bang-category" name="category" placeholder="{{t "preferences.category_placeholder"}}" value="custom">
            </div>
            <button type="submit" class="btn btn-primary">{{t "preferences.add_bang"}}</button>
        </form>
    </section>

    <section class="section-card preferences-section" data-preference-tab="interface" aria-labelledby="add-to-browser-heading">
        <h2 id="add-to-browser-heading">{{t "preferences.add_to_browser_heading"}}</h2>
        <p class="help-text">{{t "preferences.add_to_browser_help"}}</p>

        <div class="browser-add">
            <p>
                {{t "preferences.add_to_browser_instructions"}}
            </p>
            <p>
                <strong>{{t "preferences.opensearch_url_label"}}:</strong>
                <code id="opensearch-url">{{.ServerURL}}/opensearch.xml</code>
            </p>
            <div class="form-group">
                <label for="custom-engine-name">{{t "preferences.custom_engine_name_optional"}}</label>
                <input class="form-input" type="text" id="custom-engine-name" placeholder="{{.Config.Server.Title}}">
                <button type="button" id="copy-opensearch" class="btn btn-secondary">{{t "preferences.copy_opensearch_url"}}</button>
            </div>
        </div>
    </section>
</div>
{{end}}
