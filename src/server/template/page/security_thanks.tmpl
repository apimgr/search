{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t "accessibility.breadcrumb"}}"><a href="/server/security">← {{t "security.overview_title"}}</a></nav>
        <h1 class="page-title">{{t "security.thanks_title"}}</h1>
    </header>

    <div class="page-content">
        <section class="section-card" aria-labelledby="security-thanks-heading">
            <h2 id="security-thanks-heading">{{t "security.thanks_title"}}</h2>
            <p>{{t "security.thanks_intro"}}</p>
            {{if .Entries}}
            <ul class="security-thanks-list">
                {{range .Entries}}
                <li>{{.Credit}} ({{.Date}} · {{.Severity}})</li>
                {{end}}
            </ul>
            {{else}}
            <p class="security-thanks-empty">{{t "security.thanks_empty"}}</p>
            {{end}}
        </section>
    </div>
</div>
{{end}}
