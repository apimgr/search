{{define "content"}}
<div class="static-page security-thanks-page">
    <header class="page-header">
        <h1>{{t "security.thanks_title"}}</h1>
    </header>

    <div class="page-content">
        <section class="security-section">
            <p>{{t "security.thanks_intro"}}</p>
            {{if .Entries}}
            <ul class="security-thanks-list">
                {{range .Entries}}
                <li>{{.Credit}} ({{.Date}} · {{.Severity}})</li>
                {{end}}
            </ul>
            {{else}}
            <p class="security-thanks-empty">{{t "security.thanks_empty"}}</p>
            {{end}}
        </section>
    </div>
</div>
{{end}}
