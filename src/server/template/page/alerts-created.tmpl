{{define "content"}}
<section class="page-section alert-page">
    <div class="page-header">
        <h1>{{t "alerts.created_title"}}</h1>
    </div>
    <p>{{t "alerts.alert_active"}}</p>
    {{if .OwnerToken}}
    <div class="owner-token-issued" role="status">
        <h2>{{t "preferences.owner_tokens.primary_token"}}</h2>
        <p>{{t "preferences.owner_tokens.restore_description"}}</p>
        <code class="token-value">{{.OwnerToken}}</code>
    </div>
    {{end}}
    {{if .ManageURL}}
    <p><strong>{{t "alerts.manage_link_label"}}</strong> <a href="{{.ManageURL}}">{{.ManageURL}}</a></p>
    {{end}}
    {{if .RSSURL}}
    <p><strong>{{t "alerts.private_rss_feed_label"}}</strong> <a href="{{.RSSURL}}">{{.RSSURL}}</a></p>
    {{end}}
    {{if .WebhookSecret}}
    <div class="owner-token-issued" role="status">
        <h2>{{t "alerts.webhook_secret_label"}}</h2>
        <p>{{t "alerts.webhook_secret_help"}}</p>
        <code class="copy-value">{{.WebhookSecret}}</code>
    </div>
    {{end}}
</section>
{{end}}
