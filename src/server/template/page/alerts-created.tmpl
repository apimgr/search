{{define "content"}}
<div class="container container-sm">
    <header class="page-header">
        <h1 class="page-title">{{t "alerts.created_title"}}</h1>
    </header>
    <section class="section-card" aria-labelledby="alert-created-heading">
        <h2 id="alert-created-heading">{{t "alerts.alert_active"}}</h2>
    {{if .OwnerToken}}
    <div class="owner-token-issued" role="status">
        <h3>{{t "preferences.owner_tokens.primary_token"}}</h3>
        <p>{{t "preferences.owner_tokens.restore_description"}}</p>
        <code class="token-value">{{.OwnerToken}}</code>
    </div>
    {{end}}
    {{if .ManageURL}}
    <p><strong>{{t "alerts.manage_link_label"}}</strong> <a href="{{.ManageURL}}">{{.ManageURL}}</a></p>
    {{end}}
    {{if .RSSURL}}
    <p><strong>{{t "alerts.private_rss_feed_label"}}</strong> <a href="{{.RSSURL}}">{{.RSSURL}}</a></p>
    {{end}}
    {{if .WebhookSecret}}
    <div class="owner-token-issued" role="status">
        <h3>{{t "alerts.webhook_secret_label"}}</h3>
        <p>{{t "alerts.webhook_secret_help"}}</p>
        <code class="copy-value">{{.WebhookSecret}}</code>
    </div>
    {{end}}
    </section>
</div>
{{end}}
