{{define "content"}}
<section class="page-section alert-page">
    <div class="page-header">
        <h1>{{t "alerts.created_title"}}</h1>
    </div>
    <p>{{t "alerts.alert_active"}}</p>
    {{if .OwnerToken}}
    <div class="owner-token-issued" role="status">
        <h2>Primary owner token</h2>
        <p>Save this token to manage resources from another browser or API client. It is also available from your preferences page.</p>
        <code class="token-value">{{.OwnerToken}}</code>
    </div>
    {{end}}
    {{if .ManageURL}}
    <p><strong>{{t "alerts.manage_link_label"}}</strong> <a href="{{.ManageURL}}">{{.ManageURL}}</a></p>
    {{end}}
    {{if .RSSURL}}
    <p><strong>{{t "alerts.private_rss_feed_label"}}</strong> <a href="{{.RSSURL}}">{{.RSSURL}}</a></p>
    {{end}}
</section>
{{end}}
