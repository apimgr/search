                <li class="hub-item"><code>thesaurus:happy</code><span>{{t "help.direct.content.thesaurus"}}</span></li>
                <li class="hub-item"><code>slang:yolo</code><span>{{t "help.direct.content.slang"}}</span></li>
                <li class="hub-item"><code>country:DE</code><span>{{t "help.direct.content.country"}}</span></li>
                <li class="hub-item"><code>license:MIT</code><span>{{t "help.direct.content.license"}}</span></li>
            </ul>

            <h3>{{t "help.direct.text.heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>lorem:3</code><span>{{t "help.direct.text.lorem"}}</span></li>
                <li class="hub-item"><code>word:hello world</code><span>{{t "help.direct.text.word"}}</span></li>
                <li class="hub-item"><code>diff:text1|text2</code><span>{{t "help.direct.text.diff"}}</span></li>
                <li class="hub-item"><code>useragent:my</code><span>{{t "help.direct.text.useragent"}}</span></li>
                <li class="hub-item"><code>mime:application/json</code><span>{{t "help.direct.text.mime"}}</span></li>
            </ul>

            <h3>{{t "help.direct.directories.heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>directory:linux iso</code><span>{{t "help.direct.directories.linux"}}</span></li>
                <li class="hub-item"><code>directory:pdf book</code><span>{{t "help.direct.directories.pdf"}}</span></li>
