                <li class="hub-item"><code>subnet:192.168.1.0/24</code><span>{{t "help.direct.network.subnet"}}</span></li>
                <li class="hub-item"><code>resolve:example.com</code><span>{{t "help.direct.network.resolve"}}</span></li>
                <li class="hub-item"><code>robots:example.com</code><span>{{t "help.direct.network.robots"}}</span></li>
                <li class="hub-item"><code>sitemap:example.com</code><span>{{t "help.direct.network.sitemap"}}</span></li>
                <li class="hub-item"><code>tech:example.com</code><span>{{t "help.direct.network.tech"}}</span></li>
                <li class="hub-item"><code>feed:example.com</code><span>{{t "help.direct.network.feed"}}</span></li>
                <li class="hub-item"><code>expand:short.url/x</code><span>{{t "help.direct.network.expand"}}</span></li>
                <li class="hub-item"><code>safe:example.com</code><span>{{t "help.direct.network.safe"}}</span></li>
            </ul>

            <h3>{{t "help.direct.encoding.heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>qr:https://example.com</code><span>{{t "help.direct.encoding.qr"}}</span></li>
                <li class="hub-item"><code>jwt:token</code><span>{{t "help.direct.encoding.jwt"}}</span></li>
                <li class="hub-item"><code>html:&lt;b&gt;text&lt;/b&gt;</code><span>{{t "help.direct.encoding.html"}}</span></li>
                <li class="hub-item"><code>escape:hello &amp; world</code><span>{{t "help.direct.encoding.escape"}}</span></li>
                <li class="hub-item"><code>ascii:hello</code><span>{{t "help.direct.encoding.ascii"}}</span></li>
                <li class="hub-item"><code>unicode:U+1F600</code><span>{{t "help.direct.encoding.unicode"}}</span></li>
                <li class="hub-item"><code>emoji:smile</code><span>{{t "help.direct.encoding.emoji"}}</span></li>
            </ul>

            <h3>{{t "help.direct.dev.heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>json:format {"key":"val"}</code><span>{{t "help.direct.dev.json"}}</span></li>
                <li class="hub-item"><code>yaml:from-json {"key":"val"}</code><span>{{t "help.direct.dev.yaml"}}</span></li>
                <li class="hub-item"><code>regex:[a-z]+</code><span>{{t "help.direct.dev.regex"}}</span></li>
                <li class="hub-item"><code>beautify:code</code><span>{{t "help.direct.dev.beautify"}}</span></li>
