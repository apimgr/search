            </ul>

            <h3>{{t "help.direct.reference.heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>tldr:git</code><span>{{t "help.direct.reference.tldr"}}</span></li>
                <li class="hub-item"><code>man:grep</code><span>{{t "help.direct.reference.man"}}</span></li>
                <li class="hub-item"><code>cheat:git</code><span>{{t "help.direct.reference.cheat"}}</span></li>
                <li class="hub-item"><code>rfc:2616</code><span>{{t "help.direct.reference.rfc"}}</span></li>
                <li class="hub-item"><code>cve:CVE-2024-1234</code><span>{{t "help.direct.reference.cve"}}</span></li>
                <li class="hub-item"><code>pkg:express</code><span>{{t "help.direct.reference.pkg"}}</span></li>
