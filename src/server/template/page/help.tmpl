        {{/* Search Operators */}}
        <section id="search-operators" class="section-card" aria-labelledby="search-operators-heading">
            <h2 id="search-operators-heading">{{t "help.operators.heading"}}</h2>
            <p>{{t "help.operators.intro"}}</p>
            <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr><th scope="col">{{t "help.operators.th_operator"}}</th><th scope="col">{{t "help.operators.th_example"}}</th><th scope="col">{{t "help.operators.th_description"}}</th></tr>
                </thead>
                <tbody>
                    <tr><td><code>"..."</code></td><td><code>"exact phrase"</code></td><td>{{t "help.operators.exact_phrase"}}</td></tr>
                    <tr><td><code>-word</code></td><td><code>apple -fruit</code></td><td>{{t "help.operators.exclude_word"}}</td></tr>
                    <tr><td><code>*</code></td><td><code>best * for python</code></td><td>{{t "help.operators.wildcard"}}</td></tr>
                    <tr><td><code>OR</code></td><td><code>cat OR dog</code></td><td>{{t "help.operators.or"}}</td></tr>
                    <tr><td><code>AND</code></td><td><code>privacy AND security</code></td><td>{{t "help.operators.and"}}</td></tr>
                    <tr><td><code>site:</code></td><td><code>site:example.com query</code></td><td>{{t "help.operators.site"}}</td></tr>
                    <tr><td><code>-site:</code></td><td><code>-site:spam.com query</code></td><td>{{t "help.operators.site_exclude"}}</td></tr>
                    <tr><td><code>filetype:</code></td><td><code>filetype:pdf report</code></td><td>{{t "help.operators.filetype"}}</td></tr>
                    <tr><td><code>intitle:</code></td><td><code>intitle:guide</code></td><td>{{t "help.operators.intitle"}}</td></tr>
                    <tr><td><code>inurl:</code></td><td><code>inurl:blog</code></td><td>{{t "help.operators.inurl"}}</td></tr>
                    <tr><td><code>intext:</code></td><td><code>intext:privacy policy</code></td><td>{{t "help.operators.intext"}}</td></tr>
                    <tr><td><code>define:</code></td><td><code>define:ephemeral</code></td><td>{{t "help.operators.define"}}</td></tr>
                    <tr><td><code>before:</code></td><td><code>before:2023-01-01 python</code></td><td>{{t "help.operators.before"}}</td></tr>
                    <tr><td><code>after:</code></td><td><code>after:2024-01-01 python</code></td><td>{{t "help.operators.after"}}</td></tr>
                    <tr><td><code>lang:</code></td><td><code>lang:en linux</code></td><td>{{t "help.operators.lang"}}</td></tr>
                    <tr><td><code>related:</code></td><td><code>related:github.com</code></td><td>{{t "help.operators.related"}}</td></tr>
                    <tr><td><code>cache:</code></td><td><code>cache:example.com</code></td><td>{{t "help.operators.cache"}}</td></tr>
                    <tr><td><code>info:</code></td><td><code>info:example.com</code></td><td>{{t "help.operators.info"}}</td></tr>
                    <tr><td><code>define:</code></td><td><code>define:ephemeral</code></td><td>{{t "help.operators.define_alt"}}</td></tr>
                    <tr><td><code>weather:</code></td><td><code>weather:tokyo</code></td><td>{{t "help.operators.weather"}}</td></tr>
                    <tr><td><code>stocks:</code></td><td><code>stocks:AAPL</code></td><td>{{t "help.operators.stocks"}}</td></tr>
                    <tr><td><code>map:</code></td><td><code>map:berlin</code></td><td>{{t "help.operators.map"}}</td></tr>
                    <tr><td><code>movie:</code></td><td><code>movie:arrival</code></td><td>{{t "help.operators.movie"}}</td></tr>
                    <tr><td><code>source:</code></td><td><code>source:reuters ai</code></td><td>{{t "help.operators.source"}}</td></tr>
                </tbody>
            </table>
            </div>
        </section>

        {{/* Keyboard Shortcuts */}}
        <section id="keyboard-shortcuts" class="section-card" aria-labelledby="keyboard-shortcuts-heading">
            <h2 id="keyboard-shortcuts-heading">{{t "help.shortcuts.heading"}}</h2>
            <p>{{t "help.shortcuts.intro"}}</p>
            <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr><th scope="col">{{t "help.shortcuts.th_shortcut"}}</th><th scope="col">{{t "help.shortcuts.th_action"}}</th></tr>
                </thead>
                <tbody>
                    <tr><td><kbd>/</kbd></td><td>{{t "help.shortcuts.focus_search"}}</td></tr>
                    <tr><td><kbd>s</kbd></td><td>{{t "nav.settings"}}</td></tr>
                    <tr><td><kbd>Escape</kbd></td><td>{{t "help.shortcuts.clear_close"}}</td></tr>
                    <tr><td><kbd>t</kbd></td><td>{{t "help.shortcuts.cycle_theme"}}</td></tr>
                    <tr><td><kbd>?</kbd></td><td>{{t "help.shortcuts.show_help"}}</td></tr>
                    <tr><td><kbd>j</kbd> / <kbd>k</kbd></td><td>{{t "help.shortcuts.navigate_results"}}</td></tr>
                    <tr><td><kbd>Enter</kbd></td><td>{{t "help.shortcuts.open_selected"}}</td></tr>
                    <tr><td><kbd>o</kbd> / <kbd>O</kbd></td><td>{{t "help.shortcuts.open_tab_or_new"}}</td></tr>
                    <tr><td><kbd>h</kbd> / <kbd>l</kbd></td><td>{{t "help.shortcuts.prev_next_page"}}</td></tr>
                    <tr><td><kbd>g</kbd><kbd>g</kbd> / <kbd>G</kbd></td><td>{{t "help.shortcuts.first_last"}}</td></tr>
                    <tr><td><kbd>1</kbd>–<kbd>9</kbd></td><td>{{t "help.shortcuts.open_n"}}</td></tr>
                </tbody>
            </table>
            </div>
        </section>

        {{/* API Documentation */}}
        <section id="api-docs" class="section-card" aria-labelledby="api-docs-heading">
            <h2 id="api-docs-heading">{{t "help.api.heading"}}</h2>
            <p>{{t "help.api.intro"}}</p>
            <div class="hub-list">
                <a href="/server/docs/swagger" class="hub-link">
                    <span class="hub-title">{{t "help.api.openapi_heading"}}</span>
                    <span class="hub-desc">{{t "help.api.openapi_desc"}}</span>
                </a>
                <a href="/server/docs/graphql" class="hub-link">
                    <span class="hub-title">{{t "help.api.graphql_heading"}}</span>
                    <span class="hub-desc">{{t "help.api.graphql_desc"}}</span>
                </a>
            </div>

            <h3>{{t "help.api.endpoints_heading"}}</h3>
            <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr><th scope="col">{{t "help.api.th_method"}}</th><th scope="col">{{t "help.api.th_endpoint"}}</th><th scope="col">{{t "help.api.th_description"}}</th></tr>
                </thead>
                <tbody>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/search</code></td><td>{{t "help.api.ep_search"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/search/related</code></td><td>{{t "help.api.ep_related"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/autocomplete</code></td><td>{{t "help.api.ep_autocomplete"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/instant</code></td><td>{{t "help.api.ep_instant"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/direct/{type}/{term}</code></td><td>{{t "help.api.ep_direct_prefix"}} <code>type:term</code> {{t "help.api.ep_direct_suffix"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/engines</code></td><td>{{t "help.api.ep_engines"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/categories</code></td><td>{{t "help.api.ep_categories"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/server/help</code></td><td>{{t "help.api.ep_help_json"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>/server/docs/swagger</code></td><td>{{t "help.api.openapi_heading"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>{{.APIBasePath}}/server/swagger</code> / <code>/api/swagger</code></td><td>{{t "help.api.ep_openapi"}}</td></tr>
                    <tr><td><code>GET</code></td><td><code>/server/docs/graphql</code></td><td>{{t "help.api.graphql_heading"}}</td></tr>
                    <tr><td><code>POST</code></td><td><code>{{.APIBasePath}}/server/graphql</code> / <code>/api/graphql</code></td><td>{{t "help.api.ep_graphql"}}</td></tr>
                    {{if .Config.Search.OpenSearch.Enabled}}
                    <tr><td><code>GET</code></td><td><code>/opensearch.xml</code></td><td>{{t "help.api.ep_opensearch"}}</td></tr>
                    {{end}}
                </tbody>
            </table>
            </div>

            <h3>{{t "help.api.example_search"}}</h3>
            <pre class="code-block"><code># Search for "golang tutorial"
curl "{{.ServerURL}}{{.APIBasePath}}/search?q=golang+tutorial&category=general&limit=20"

# Image search with strict safe search
curl "{{.ServerURL}}{{.APIBasePath}}/search?q=nature&category=images&safe_search=2"

# Get related searches
curl "{{.ServerURL}}{{.APIBasePath}}/search/related?q=golang+tutorial"</code></pre>

            <h3>{{t "help.api.example_instant"}}</h3>
            <pre class="code-block"><code># Calculator
curl "{{.ServerURL}}{{.APIBasePath}}/instant?q=sqrt(144)"

# Unit conversion
curl "{{.ServerURL}}{{.APIBasePath}}/instant?q=convert+10+km+to+miles"

# IP lookup
curl "{{.ServerURL}}{{.APIBasePath}}/instant?q=what+is+my+ip"</code></pre>

            <h3>{{t "help.api.example_direct"}}</h3>
            <pre class="code-block"><code># HTTP status explanation
curl "{{.ServerURL}}{{.APIBasePath}}/direct/http/404"

# Rules of the Internet
curl "{{.ServerURL}}{{.APIBasePath}}/direct/rules/34"</code></pre>
        </section>

        {{/* Privacy Features */}}
        <section id="privacy" class="section-card" aria-labelledby="privacy-heading">
            <h2 id="privacy-heading">{{t "help.privacy.heading"}}</h2>
            <ul>
                <li><strong>{{t "help.privacy.no_tracking_label"}}</strong> {{t "help.privacy.no_tracking_text"}}</li>
                <li><strong>{{t "help.privacy.no_history_label"}}</strong> {{t "help.privacy.no_history_text"}}</li>
                <li><strong>{{t "help.privacy.sanitized_links_label"}}</strong> {{t "help.privacy.sanitized_links_text"}}</li>
                <li><strong>{{t "help.privacy.tor_support_label"}}</strong> {{t "help.privacy.tor_support_prefix"}}{{if and .Config.Server.Tor.Enabled .OnionAddress}} (<a href="#tor-access">{{t "help.privacy.tor_support_see_below"}}</a>){{end}}</li>
                <li><strong>{{t "help.privacy.minimal_cookies_label"}}</strong> {{t "help.privacy.minimal_cookies_text"}}</li>
                <li><strong>{{t "help.privacy.no_js_label"}}</strong> {{t "help.privacy.no_js_text"}}</li>
                <li><strong>{{t "help.privacy.open_source_label"}}</strong> {{t "help.privacy.open_source_text"}}</li>
            </ul>
        </section>

        {{/* An address is populated only while the Tor hidden service is live. */}}
        {{if and .Config.Server.Tor.Enabled .OnionAddress}}
        <section id="tor-access" class="section-card" aria-labelledby="tor-access-heading">
            <h2 id="tor-access-heading">{{t "help.tor.heading"}}</h2>
            <p>{{t "help.tor.intro"}}</p>

            <h3>{{t "help.tor.onion_heading"}}</h3>
            <div class="code-block">
                <code id="onion-addr" class="code-content">{{.OnionAddress}}</code>
                <button type="button" class="copy-btn" data-copy="{{.OnionAddress}}" aria-label="{{t "help.tor.copy_aria"}}">
                    <span class="copy-icon">📋</span>
                    <span class="copy-text" aria-live="polite">{{t "help.tor.copy_label"}}</span>
                </button>
            </div>
            <h3>{{t "help.tor.how_to_heading"}}</h3>
            <ol>
                <li>{{t "help.tor.step_download"}} <a href="https://www.torproject.org/download/" target="_blank" rel="noopener">Tor Browser</a></li>
                <li>{{t "help.tor.step_open"}}</li>
                <li>{{t "help.tor.step_paste"}}</li>
            </ol>

            <p class="tor-note">{{t "help.tor.footer_note"}}</p>
        </section>
        {{end}}

        {{/* The manager exposes an address only while the I2P provider is live. */}}
        {{if .I2PAddress}}
        <section id="i2p-access" class="section-card" aria-labelledby="i2p-access-heading">
            <h2 id="i2p-access-heading">{{t "help.i2p.heading"}}</h2>
            <p>{{t "help.i2p.intro"}}</p>
            <h3>{{t "help.i2p.address_heading"}}</h3>
            <div class="code-block">
                <code id="i2p-addr" class="code-content">{{.I2PAddress}}</code>
                <button type="button" class="copy-btn" data-copy="{{.I2PAddress}}" aria-label="{{t "accessibility.copy_to_clipboard"}}">
                    <span class="copy-icon">📋</span>
                    <span class="copy-text" aria-live="polite">{{t "help.tor.copy_label"}}</span>
                </button>
            </div>
            <h3>{{t "help.i2p.how_to_heading"}}</h3>
            <ol>
                <li>{{t "help.i2p.step_install"}} <a href="https://geti2p.net/en/download" target="_blank" rel="noopener">I2P</a> {{t "help.i2p.step_or"}} <a href="https://i2pd.website/" target="_blank" rel="noopener">i2pd</a> {{t "help.i2p.step_connect"}}</li>
                <li>{{t "help.i2p.step_proxy"}} <code>127.0.0.1:4444</code></li>
                <li>{{t "help.i2p.step_address"}}</li>
            </ol>
            <p>{{t "help.i2p.note"}}</p>
        </section>
        {{end}}

        {{/* FAQ */}}
        <section id="faq" class="section-card" aria-labelledby="faq-heading">
            <h2 id="faq-heading">{{t "help.faq.heading"}}</h2>
            <div>
                <details>
                    <summary>{{t "help.faq.q_results_diff"}}</summary>
                    <p>{{t "help.faq.a_results_diff"}}</p>
                </details>
                <details>
                    <summary>{{t "help.faq.q_tor_access_summary"}}</summary>
                    <p>{{t "help.faq.a_tor_access_prefix"}} <a href="https://www.torproject.org/download/" target="_blank" rel="noopener">Tor Browser</a> {{t "help.faq.a_tor_access_suffix"}}{{if and .Config.Server.Tor.Enabled .OnionAddress}} <a href="#tor-access">{{t "help.faq.a_tor_access_see_section"}}</a>{{end}}</p>
                </details>
                <details>
                    <summary>{{t "help.faq.q_self_host"}}</summary>
                    <p>{{t "help.faq.a_self_host_prefix"}}{{if .Config.Server.Branding.SourceCodeURL}} <a href="{{.Config.Server.Branding.SourceCodeURL}}" target="_blank" rel="noopener">{{t "help.faq.a_self_host_repo"}}</a>{{end}}</p>
                </details>
                <details>
                    <summary>{{t "help.faq.q_engines"}}</summary>
                    <p>{{t "help.faq.a_engines"}}</p>
                </details>
                <details>
                    <summary>{{t "help.faq.q_instant"}}</summary>
                    <p>{{t "help.faq.a_instant"}}</p>
                </details>
            </div>
        </section>

        <section id="troubleshooting" class="section-card" aria-labelledby="troubleshooting-heading">
            <h2 id="troubleshooting-heading">{{t "help.troubleshooting.heading"}}</h2>
            <p>{{t "help.troubleshooting.search"}}</p>
            <p>{{t "help.troubleshooting.access"}}</p>
            <p>{{t "help.troubleshooting.alerts"}}</p>
        </section>

        {{/* Need Help */}}
        <section class="section-card" aria-labelledby="need-more-heading">
            <h2 id="need-more-heading">{{t "help.need_more.heading"}}</h2>
            <p>{{t "help.need_more.text_prefix"}} <a href="/server/security">{{t "help.need_more.link"}}</a>{{t "help.need_more.text_suffix"}}</p>
        </section>
    {{end}}
    <section class="section-card" aria-labelledby="more-help-heading">
        <h2 id="more-help-heading">{{t "help.more_title"}}</h2>
        <ul class="hub-list">
            {{range index .Data "helpPages"}}
            <li class="hub-item"><a class="hub-link" href="{{.Path}}"><span class="hub-title">{{t .TitleKey}}</span><span class="hub-desc">{{t .DescriptionKey}}</span></a></li>
            {{end}}
        </ul>
    </section>
</div>
{{end}}
