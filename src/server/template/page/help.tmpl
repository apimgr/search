{{define "content"}}
<div class="container container-lg">
    <header class="page-header">
        <h1 class="page-title">{{t "help.title"}}</h1>
        <p class="page-lead">{{tf "help.subtitle" "app_name" (default (t "home.brand_fallback") .Config.Server.Branding.Title)}}</p>
    </header>

    {{if .Config.Server.Pages.Help.Content}}
    <section class="section-card markdown" aria-labelledby="help-custom-heading">
        <h2 id="help-custom-heading">{{t "help.getting_started.heading"}}</h2>
        {{.Config.Server.Pages.Help.Content | markdownToHTML}}
    </section>
    {{else}}
        {{/* Table of Contents */}}
        <nav class="section-card" aria-labelledby="help-toc-heading">
            <h2 id="help-toc-heading">{{t "help.toc.heading"}}</h2>
            <ul>
                <li><a href="#getting-started">{{t "help.toc.getting_started"}}</a></li>
                <li><a href="#search-categories">{{t "help.toc.search_categories"}}</a></li>
                <li><a href="#bang-commands">{{t "help.toc.bang_commands"}}</a></li>
                <li><a href="#direct-answers">{{t "help.toc.direct_answers"}}</a></li>
                <li><a href="#search-operators">{{t "help.toc.search_operators"}}</a></li>
                <li><a href="#keyboard-shortcuts">{{t "help.toc.keyboard_shortcuts"}}</a></li>
                <li><a href="#api-docs">{{t "help.toc.api_docs"}}</a></li>
                <li><a href="#privacy">{{t "help.toc.privacy"}}</a></li>
                {{if and .Config.Server.Tor.Enabled .OnionAddress}}<li><a href="#tor-access">{{t "help.toc.tor_access"}}</a></li>{{end}}
                {{if .I2PAddress}}<li><a href="#i2p-access">{{t "help.i2p.heading"}}</a></li>{{end}}
                <li><a href="#faq">{{t "help.toc.faq"}}</a></li>
            </ul>
        </nav>

        {{/* Getting Started */}}
        <section id="getting-started" class="section-card" aria-labelledby="getting-started-heading">
            <h2 id="getting-started-heading">{{t "help.getting_started.heading"}}</h2>
            <p>{{tf "help.getting_started.intro_prefix" "app_name" (default (t "home.brand_fallback") .Config.Server.Branding.Title)}} <kbd>Enter</kbd> {{t "help.getting_started.intro_suffix"}}</p>
            <p>{{t "help.getting_started.no_tracking"}}</p>
        </section>

        {{/* Search Categories */}}
        <section id="search-categories" class="section-card" aria-labelledby="search-categories-heading">
            <h2 id="search-categories-heading">{{t "help.categories.heading"}}</h2>
            <p>{{t "help.categories.intro"}}</p>
            <ul class="hub-list">
                <li class="hub-item">
                    <span>🌐</span>
                    <span class="hub-title">{{t "help.categories.general.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.general.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>🖼️</span>
                    <span class="hub-title">{{t "help.categories.images.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.images.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>🎬</span>
                    <span class="hub-title">{{t "help.categories.videos.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.videos.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>📰</span>
                    <span class="hub-title">{{t "help.categories.news.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.news.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>🗺️</span>
                    <span class="hub-title">{{t "help.categories.maps.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.maps.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>📁</span>
                    <span class="hub-title">{{t "help.categories.files.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.files.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>🎵</span>
                    <span class="hub-title">{{t "help.categories.music.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.music.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>💻</span>
                    <span class="hub-title">{{t "help.categories.it.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.it.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>📚</span>
                    <span class="hub-title">{{t "help.categories.science.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.science.description"}}</span>
                </li>
                <li class="hub-item">
                    <span>👥</span>
                    <span class="hub-title">{{t "help.categories.social.label"}}</span>
                    <span class="hub-desc">{{t "help.categories.social.description"}}</span>
                </li>
            </ul>
        </section>

        {{/* Bang Commands */}}
        <section id="bang-commands" class="section-card" aria-labelledby="bang-commands-heading">
            <h2 id="bang-commands-heading">{{t "help.bangs.heading"}}</h2>
            <p>{{t "help.bangs.intro_prefix"}} <code>!shortcut terms</code> {{t "help.bangs.intro_or"}} <code>terms !shortcut</code>{{t "help.bangs.intro_suffix"}}</p>

            <h3>{{t "help.bangs.popular_heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>!g</code> Google</li>
                <li class="hub-item"><code>!ddg</code> DuckDuckGo</li>
                <li class="hub-item"><code>!b</code> Bing</li>
                <li class="hub-item"><code>!br</code> Brave Search</li>
                <li class="hub-item"><code>!sp</code> Startpage</li>
                <li class="hub-item"><code>!w</code> Wikipedia</li>
                <li class="hub-item"><code>!yt</code> YouTube</li>
                <li class="hub-item"><code>!gh</code> GitHub</li>
                <li class="hub-item"><code>!so</code> Stack Overflow</li>
                <li class="hub-item"><code>!rd</code> Reddit</li>
                <li class="hub-item"><code>!tw</code> Twitter/X</li>
                <li class="hub-item"><code>!az</code> Amazon</li>
                <li class="hub-item"><code>!gm</code> Google Maps</li>
                <li class="hub-item"><code>!osm</code> OpenStreetMap</li>
                <li class="hub-item"><code>!wa</code> Wolfram Alpha</li>
                <li class="hub-item"><code>!mdn</code> MDN Web Docs</li>
                <li class="hub-item"><code>!npm</code> npm</li>
                <li class="hub-item"><code>!pypi</code> PyPI</li>
                <li class="hub-item"><code>!gopkg</code> Go Packages</li>
                <li class="hub-item"><code>!scholar</code> Google Scholar</li>
                <li class="hub-item"><code>!arxiv</code> arXiv</li>
                <li class="hub-item"><code>!archive</code> Internet Archive</li>
                <li class="hub-item"><code>!spot</code> Spotify</li>
            </ul>

            <h3>{{t "help.bangs.by_category_heading"}}</h3>
            <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th scope="col">{{t "help.bangs.th_category"}}</th><th scope="col">{{t "help.bangs.th_examples"}}</th></tr></thead>
                <tbody>
                    <tr><td>{{t "help.bangs.cat_search"}}</td><td><code>!g</code> <code>!b</code> <code>!ddg</code> <code>!br</code> <code>!sp</code> <code>!q</code> <code>!kagi</code> <code>!perplexity</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_images"}}</td><td><code>!gi</code> <code>!bi</code> <code>!fl</code> <code>!pexels</code> <code>!pixabay</code> <code>!pinterest</code> <code>!tineye</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_video"}}</td><td><code>!yt</code> <code>!v</code> <code>!twitch</code> <code>!tiktok</code> <code>!rumble</code> <code>!pt</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_maps"}}</td><td><code>!gm</code> <code>!osm</code> <code>!waze</code> <code>!yelp</code> <code>!tripadvisor</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_news"}}</td><td><code>!gn</code> <code>!hn</code> <code>!bbc</code> <code>!techcrunch</code> <code>!verge</code> <code>!reuters</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_social"}}</td><td><code>!tw</code> <code>!mast</code> <code>!fb</code> <code>!linkedin</code> <code>!bluesky</code> <code>!lb</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_code_dev"}}</td><td><code>!gh</code> <code>!gl</code> <code>!so</code> <code>!npm</code> <code>!pypi</code> <code>!gopkg</code> <code>!docker</code> <code>!mdn</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_shopping"}}</td><td><code>!az</code> <code>!eb</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_science"}}</td><td><code>!scholar</code> <code>!arxiv</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_reference"}}</td><td><code>!w</code> <code>!wa</code> <code>!britannica</code></td></tr>
                    <tr><td>{{t "help.bangs.cat_files"}}</td><td><code>!archive</code></td></tr>
                </tbody>
            </table>
            </div>

            <h3>{{t "help.bangs.examples_heading"}}</h3>
            <ul class="example-list">
                <li><code>!g python tutorial</code> — {{t "help.bangs.ex_g_desc"}}</li>
                <li><code>privacy search !ddg</code> — {{t "help.bangs.ex_ddg_desc"}}</li>
                <li><code>!w artificial intelligence</code> — {{t "help.bangs.ex_w_desc"}}</li>
                <li><code>!gh octocat</code> — {{t "help.bangs.ex_gh_desc"}}</li>
                <li><code>!npm express</code> — {{t "help.bangs.ex_npm_desc"}}</li>
            </ul>
            <h3>{{t "help.bangs.all_heading"}}</h3>
            <div class="table-wrapper">
                <table class="data-table">
                    <caption>{{t "help.bangs.all_caption"}}</caption>
                    <thead><tr><th scope="col">{{t "help.bangs.th_shortcut"}}</th><th scope="col">{{t "help.bangs.th_name"}}</th><th scope="col">{{t "help.bangs.th_category"}}</th><th scope="col">{{t "help.bangs.th_description"}}</th></tr></thead>
                    <tbody>{{range index .Data "bangs"}}<tr><td><code>!{{.Shortcut}}</code></td><td>{{.Name}}</td><td>{{.Category}}</td><td>{{.Description}}</td></tr>{{end}}</tbody>
                </table>
            </div>
        </section>

        {{/* Direct Answers */}}
        <section id="direct-answers" class="section-card" aria-labelledby="direct-answers-heading">
            <h2 id="direct-answers-heading">{{t "help.direct.heading"}}</h2>
            <p><strong>{{t "help.direct.intro_da_label"}}</strong> {{t "help.direct.intro_da_text_prefix"}} <code>type:term</code> {{t "help.direct.intro_da_text_suffix"}} <strong>{{t "help.direct.intro_ia_label"}}</strong> {{t "help.direct.intro_ia_text"}}</p>

            <h3>{{t "help.direct.full_page_heading"}} (<code>type:term</code>)</h3>

            <h3>{{t "help.direct.network.heading"}}</h3>
            <ul class="hub-list">
                <li class="hub-item"><code>dns:example.com</code><span>{{t "help.direct.network.dns"}}</span></li>
                <li class="hub-item"><code>whois:example.com</code><span>{{t "help.direct.network.whois"}}</span></li>
