{{define "content"}}
<div class="container container-sm">
    <header class="page-header">
        <h1 class="page-title">{{.StatusText}}</h1>
        <p class="page-lead">{{t "common.error"}}</p>
    </header>
    <section class="section-card error-container" aria-labelledby="error-code">
        <h2 id="error-code" class="error-code">{{.StatusCode}}</h2>
        <p class="error-message">{{.Message}}</p>

        {{if and .Config.IsDevelopment .ErrorDetails}}
        <details class="error-details">
            <summary>{{t "errors.technical_details"}}</summary>
            <pre>{{.ErrorDetails}}</pre>
        </details>
        {{end}}

        <div class="error-actions">
            <a href="/" class="btn btn-primary">{{t "errors.go_home"}}</a>
        </div>
    </section>
</div>
{{end}}
