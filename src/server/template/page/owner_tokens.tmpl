{{define "content"}}
<div class="static-page preferences-page">
    <header class="page-header">
        <h1>{{t "preferences.owner_tokens.heading"}}</h1>
        <p class="subtitle">{{t "preferences.owner_tokens.heading"}}</p>
        <a href="/server/preferences">{{t "preferences.title"}}</a>
    </header>
    {{with index .Data "ownerTokenMessage"}}<p role="status">{{.}}</p>{{end}}
    {{with index .Data "ownerTokenRevealed"}}
    <div class="token-reveal" role="alert">
        <p>{{t "preferences.owner_tokens.reveal_notice"}}</p>
        <code class="token-value">{{.}}</code>
    </div>
    {{end}}
    {{with index .Data "ownerTokens"}}
    <section class="preferences-section">
        <h2>{{t "preferences.owner_tokens.primary_token"}}</h2>
        <code>{{index $.Data "ownerPrimaryMasked"}}</code>
        <form action="/server/preferences/token/reveal" method="POST">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <button type="submit">{{t "preferences.owner_tokens.reveal_primary"}}</button>
        </form>
        <details class="confirm-disclosure">
            <summary>{{t "preferences.owner_tokens.rotate_primary"}}</summary>
            <p>{{t "preferences.owner_tokens.rotate_primary_confirm"}}</p>
            <form action="/server/preferences/token/rotate" method="POST">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="confirm" value="rotate">
                <button type="submit">{{t "preferences.owner_tokens.rotate"}}</button>
            </form>
        </details>
        <h2>{{t "preferences.owner_tokens.linked_tokens"}}</h2>
        {{range .}}
        {{if eq .Kind "linked"}}
        <article class="owner-token-item">
            <h3>{{.Name}}</h3>
            <code>{{.Masked}}</code>
            <p>{{t "health.status"}}: {{if eq .Status "active"}}{{t "preferences.owner_tokens.active"}}{{else if eq .Status "expired"}}{{t "preferences.owner_tokens.expired"}}{{else}}{{t "preferences.owner_tokens.revoked"}}{{end}} · {{t "admin.tokens_page.created"}} {{.CreatedAt}} · {{t "admin.tokens_page.last_used"}} {{.LastUsedAt}} · {{t "admin.tokens_page.expires"}} {{.ExpiresAt}}</p>
            <form action="/server/preferences/tokens/{{.ID}}/reveal" method="POST"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button type="submit">{{t "common.show"}}</button></form>
            <details class="confirm-disclosure">
                <summary>{{t "preferences.owner_tokens.rotate"}}</summary>
                <p>{{t "preferences.owner_tokens.rotate_linked_confirm"}}</p>
                <form action="/server/preferences/tokens/{{.ID}}/rotate" method="POST"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button type="submit">{{t "preferences.owner_tokens.rotate"}}</button></form>
            </details>
            <form action="/server/preferences/tokens/{{.ID}}/update" method="POST"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><label>{{t "preferences.name_label"}} <input name="name" value="{{.Name}}" maxlength="64" required></label><label>{{t "admin.tokens_page.expires"}} <select name="expires_at"><option value="never">{{t "admin.tokens_page.never"}}</option><option value="7d">{{t "preferences.owner_tokens.expiry_7d"}}</option><option value="30d">{{t "preferences.owner_tokens.expiry_30d"}}</option><option value="90d">{{t "preferences.owner_tokens.expiry_90d"}}</option><option value="1y">{{t "preferences.owner_tokens.expiry_1y"}}</option></select></label><button type="submit">{{t "common.save"}}</button></form>
            <details class="confirm-disclosure">
                <summary>{{t "admin.tokens_page.revoke"}}</summary>
                <p>{{t "preferences.owner_tokens.revoke_linked_confirm"}}</p>
                <form action="/server/preferences/tokens/{{.ID}}/revoke" method="POST"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button type="submit">{{t "admin.tokens_page.revoke"}}</button></form>
            </details>
        </article>
        {{end}}
        {{end}}
        <form action="/server/preferences/tokens" method="POST">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <label>{{t "preferences.name_label"}} <input name="name" maxlength="64" required></label>
            <label>{{t "admin.tokens_page.expires"}} <select name="expires_at"><option value="never">{{t "admin.tokens_page.never"}}</option><option value="7d">{{t "preferences.owner_tokens.expiry_7d"}}</option><option value="30d">{{t "preferences.owner_tokens.expiry_30d"}}</option><option value="90d">{{t "preferences.owner_tokens.expiry_90d"}}</option><option value="1y">{{t "preferences.owner_tokens.expiry_1y"}}</option></select></label>
            <button type="submit">{{t "preferences.owner_tokens.create_linked"}}</button>
        </form>
    </section>
    {{else}}
    <section class="preferences-section">
        <p>{{t "preferences.owner_tokens.restore_description"}}</p>
        <form action="/server/preferences/token/restore" method="POST">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <label for="restore-owner-token">{{t "preferences.owner_tokens.restore_existing"}}</label>
            <input id="restore-owner-token" name="token" type="password" autocomplete="off" required>
            <button type="submit">{{t "preferences.owner_tokens.restore_owner"}}</button>
        </form>
    </section>
    {{end}}
</div>
{{end}}
