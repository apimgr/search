{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{t "footer.terms"}}</h1>
    </header>

    {{if operatorHTMLExists "terms" .}}
    <section class="section-card markdown" aria-labelledby="terms-custom-heading">
        <h2 id="terms-custom-heading">{{t "common.details"}}</h2>
        {{operatorHTML "terms" .}}
    </section>
    {{else}}
        <section class="section-card terms-section" aria-labelledby="terms-acceptance-heading">
            <h2 id="terms-acceptance-heading">{{t "terms.acceptance_heading"}}</h2>
            <p>{{tf "terms.acceptance_description" "app_name" (default (t "home.brand_fallback") .Config.Server.Branding.Title)}}</p>
        </section>

        <section class="section-card terms-section" aria-labelledby="terms-acceptable-use-heading">
            <h2 id="terms-acceptable-use-heading">{{t "terms.acceptable_use_heading"}}</h2>
            <p>{{t "terms.acceptable_use_description"}}</p>
        </section>

        <section class="section-card terms-section" aria-labelledby="terms-liability-heading">
            <h2 id="terms-liability-heading">{{t "terms.liability_heading"}}</h2>
            <p>{{t "terms.liability_description"}}</p>
        </section>

        <section class="section-card terms-section" aria-labelledby="terms-changes-heading">
            <h2 id="terms-changes-heading">{{t "terms.changes_heading"}}</h2>
            <p>{{t "terms.changes_description"}}</p>
        </section>

        <section class="section-card terms-section" aria-labelledby="terms-governing-law-heading">
            <h2 id="terms-governing-law-heading">{{t "terms.governing_law_heading"}}</h2>
            <p>{{t "terms.governing_law_description"}}</p>
        </section>
    {{end}}
</div>
{{end}}
