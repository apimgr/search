{{define "content"}}
<div class="container container-sm">
    <header class="page-header">
        <nav class="breadcrumb" aria-label="{{t "accessibility.breadcrumb"}}"><a href="/server/security">← {{t "security.overview_title"}}</a></nav>
        <h1 class="page-title">{{t "security.report_status_title"}}</h1>
    </header>

    <section class="section-card" aria-labelledby="security-report-status-heading">
        <h2 id="security-report-status-heading">{{t "common.details"}}</h2>
        <dl>
            <dt>{{t "security.report_status_tracking_id_label"}}</dt>
            <dd>{{.TrackingID}}</dd>
            <dt>{{t "security.report_status_state_label"}}</dt>
            <dd>{{t (printf "security.report_status_state_%s" .Status)}}</dd>
        <dt>{{t "security.report_status_comment_label"}}</dt>
        <dd>{{if .ResearcherComment}}{{.ResearcherComment}}{{else}}{{t "common.none"}}{{end}}</dd>
        <dt>{{t "security.report_status_disclosure_date_label"}}</dt>
        <dd>{{if .DisclosureDate}}{{.DisclosureDate}}{{else}}{{t "common.none"}}{{end}}</dd>
        </dl>
    </section>
</div>
{{end}}
