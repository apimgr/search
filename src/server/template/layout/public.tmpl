{{define "public"}}
<!DOCTYPE html>
{{/* Per AI.md PART 31: Dynamic lang and dir for RTL support */}}
<html lang="{{default "en" .Lang}}" dir="{{default "ltr" .Dir}}" class="theme-{{default "dark" .Theme}} font-size-{{default "medium" .Prefs.FontSize}} results-density-{{default "comfortable" .Prefs.ResultsDensity}}" data-theme-mode="{{default "dark" .ThemeMode}}" {{if .Prefs.AccentColor}}style="--color-accent: {{safeCSS .Prefs.AccentColor}}; --color-primary: {{safeCSS .Prefs.AccentColor}}"{{end}}>
<head>
    {{template "head" .}}
    {{block "extra_head" .}}{{end}}
    {{/* Per AI.md PART 16: analytics only when server.tracking is configured AND
         the visitor's cookie_consent grants the analytics category. Empty
         TrackingHTML renders nothing — no third-party script is fetched. */}}
    {{if .TrackingHTML}}{{.TrackingHTML}}{{end}}
</head>
<body class="public-page {{.Page}}-page">
    {{/* Skip link for keyboard navigation - WCAG 2.1 AA */}}
    <a href="#main-content" class="skip-link">{{t "accessibility.skip_to_main_content"}}</a>

    {{/* Site banners: first elements in body, before <main>, per AI.md PART 16 */}}
    {{/* Stacking order: cookie consent → announcements → PWA update */}}
    {{template "cookie_consent" .}}
    {{template "announcements" .}}

    {{/* Public header */}}
    {{template "public/header" .}}

    {{/* Sub-header search bar (non-home pages) */}}
    {{template "public/subheader" .}}

    {{/* Public navigation */}}
    {{template "public/nav" .}}
    <dialog class="pwa-install-dialog" id="pwa-install-dialog" aria-labelledby="pwa-install-title">
        <header class="mobile-preferences-header">
            <h2 id="pwa-install-title">{{t "pwa.install_title"}}</h2>
            <form method="dialog"><button type="submit" class="btn-secondary" aria-label="{{t "common.close"}}">×</button></form>
        </header>
        <ol>
            <li>{{t "pwa.ios_share"}} <img src="/static/img/ios-share.svg" width="20" height="20" alt="{{t "pwa.ios_share"}}"></li>
            <li>{{t "pwa.ios_add_to_home"}}</li>
            <li>{{t "pwa.ios_add"}}</li>
        </ol>
    </dialog>
    <main id="main-content" class="main-content" role="main">
        {{/* Flash messages */}}
        {{if .Flash}}
        <div class="flash flash-{{.Flash.Type}}" role="alert">
            {{.Flash.Message}}
            <button class="flash-close" aria-label="{{t "common.close"}}">&times;</button>
        </div>
        {{end}}

        {{/* Main content area */}}
        {{block "content" .}}{{end}}
    </main>

    {{/* Public footer */}}
    {{template "public/footer" .}}

    {{template "scripts" .}}
    {{block "extra_scripts" .}}{{end}}
</body>
</html>
{{end}}
