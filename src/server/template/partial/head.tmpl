{{define "head"}}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{{.SEO.Description}}">
<meta name="keywords" content="{{.SEO.Keywords}}">
<meta name="author" content="{{.SEO.Author}}">
<meta name="robots" content="{{.SEO.Robots}}">
<meta name="offline-title" content="{{t "offline.title"}}">
<meta name="offline-heading" content="{{t "offline.heading"}}">
<meta name="offline-message" content="{{t "offline.message"}}">
{{if .SEO.CanonicalURL}}<link rel="canonical" href="{{.SEO.CanonicalURL}}">{{end}}
{{range .SEO.MetaTags}}<meta name="{{.Name}}" content="{{.Content}}">
{{end}}
<meta name="referrer" content="no-referrer">
<meta name="csrf-token" content="{{.CSRFToken}}">

{{if .SEO.OpenGraphEnabled}}
<meta property="og:title" content="{{.SEO.Title}}">
<meta property="og:description" content="{{.SEO.Description}}">
{{if .SEO.OpenGraphImage}}<meta property="og:image" content="{{.SEO.OpenGraphImage}}">{{end}}
<meta property="og:type" content="{{.SEO.OpenGraphType}}">
{{if .SEO.CanonicalURL}}<meta property="og:url" content="{{.SEO.CanonicalURL}}">{{end}}
<meta property="og:site_name" content="{{.SEO.OpenGraphSiteName}}">
{{end}}

{{if .SEO.TwitterEnabled}}
<meta name="twitter:card" content="{{.SEO.TwitterCard}}">
<meta name="twitter:title" content="{{.SEO.Title}}">
<meta name="twitter:description" content="{{.SEO.Description}}">
{{if .SEO.OpenGraphImage}}<meta name="twitter:image" content="{{.SEO.OpenGraphImage}}">{{end}}
{{if .SEO.TwitterSite}}<meta name="twitter:site" content="{{.SEO.TwitterSite}}">{{end}}
{{if .SEO.TwitterCreator}}<meta name="twitter:creator" content="{{.SEO.TwitterCreator}}">{{end}}
{{end}}

<title>{{.SEO.Title}}</title>

{{if .Config.Server.Branding.Favicon}}
<link rel="icon" href="{{.Config.Server.Branding.Favicon}}">
{{else}}
<link rel="icon" href="{{asset "/static/img/favicon.svg"}}" type="image/svg+xml">
<link rel="icon" href="{{asset "/static/img/favicon-16.png"}}" type="image/png" sizes="16x16">
<link rel="icon" href="{{asset "/static/img/favicon-32.png"}}" type="image/png" sizes="32x32">
<link rel="icon" href="{{asset "/static/img/favicon-48.png"}}" type="image/png" sizes="48x48">
{{end}}

{{/* OpenSearch - enables "Add to browser" functionality */}}
{{if .Config.Search.OpenSearch.Enabled}}
<link rel="search" type="application/opensearchdescription+xml" title="{{.Config.Server.Title}}" href="{{.ServerURL}}/opensearch.xml">
{{end}}

{{/* PWA Manifest - per AI.md PART 16: PWA Support */}}
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#282a36">
<link rel="apple-touch-icon" href="{{asset "/static/img/icon-180.png"}}" sizes="180x180">

{{/* iOS-specific PWA meta tags - per AI.md PART 16: iOS-Specific Considerations */}}
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{.Config.Server.Title}}">
<link rel="apple-touch-startup-image" href="{{asset "/static/splash/iphone-1179x2556.png"}}" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3)">
<link rel="apple-touch-startup-image" href="{{asset "/static/splash/iphone-1284x2778.png"}}" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3)">

{{/* Per AI.md: Load order: common → components → public/admin */}}
<link rel="stylesheet" href="{{asset "/static/css/common.css"}}">
<link rel="stylesheet" href="{{asset "/static/css/components.css"}}">
<link rel="stylesheet" href="{{asset "/static/css/public.css"}}">
{{if .SEO.AccentCSSEnabled}}<link rel="stylesheet" href="{{asset "/static/css/accent.css"}}">{{end}}
{{if .SEO.CustomCSSEnabled}}<link rel="stylesheet" href="/static/css/custom.css?v={{.SEO.CustomCSSVersion}}">{{end}}
{{if eq .Page "swagger"}}<link rel="stylesheet" href="{{asset "/static/vendor/swagger-ui/swagger-ui.css"}}"><link rel="stylesheet" href="{{asset "/static/css/swagger.css"}}"><link rel="stylesheet" href="/static/css/swagger-theme.css">{{end}}
{{if eq .Page "graphql"}}<link rel="stylesheet" href="{{asset "/static/vendor/graphiql/graphiql-style.css"}}"><link rel="stylesheet" href="{{asset "/static/vendor/graphiql/graphiql.css"}}"><link rel="stylesheet" href="{{asset "/static/css/graphql.css"}}"><link rel="stylesheet" href="/static/css/graphql-theme.css">{{end}}
{{/* Per AI.md PART 16: All JS code is consolidated in app.js, loaded via scripts.tmpl */}}
{{end}}
