{{define "public/header"}}
<input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-controls="nav-panel">
<header class="header">
    <a href="/" class="site-brand">
        {{if .Config.Server.Branding.Logo}}
        <img src="{{.Config.Server.Branding.Logo}}" alt="{{default (t "home.brand_fallback") .Config.Server.Branding.Title}}" class="logo-img">
        {{else}}
        {{default (t "home.brand_fallback") .Config.Server.Branding.Title}}
        {{end}}
    </a>

    <nav class="nav-links" id="navigation" aria-label="{{t "accessibility.keyboard_navigation_heading"}}">
        <a href="/"{{if eq .Page "home"}} aria-current="page" class="active"{{end}}>{{t "nav.home"}}</a>
    </nav>

    <label for="nav-toggle" class="nav-toggle" aria-label="{{t "accessibility.toggle_navigation"}}">☰</label>

    <div class="header-actions">
        <a href="/server/preferences" class="header-icon-btn" aria-label="{{t "preferences.title"}}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
        </a>
        <form action="/theme" method="POST" class="header-theme-form">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="redirect" value="{{.RequestPath}}">
            <input type="hidden" name="theme" value="{{.NextTheme}}">
            <button type="submit" class="header-icon-btn theme-toggle" aria-label="{{t "nav.toggle_theme"}}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </form>
    </div>
</header>
{{end}}
